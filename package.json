{
	"name": "logistack",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"examples/plugins/*"
	],
	"scripts": {
		"dev:infra": "docker compose -f docker-compose.dev.yml up -d",
		"typecheck": "for d in apps/* packages/*; do (cd $d && tsc -p . --noEmit) || exit 1; done",
		"test": "bun test",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "bun run typecheck && biome check . && bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"@better-auth/core": "1.7.12",
		"@better-auth/utils": "0.5.0"
	}
}
