{
	"schema": 1,
	"id": "classicpress-without-database",
	"name": "Classicpress Without Database",
	"description": "A lightweight, stable, instantly familiar free open-source content management system, based on WordPress without the block editor (Gutenberg).",
	"category": "cms",
	"tags": [
		"cms",
		"blog",
		"content",
		"management"
	],
	"logo": "logos/classicpress-without-database.svg",
	"docs": "https://www.classicpress.net/",
	"version": "sha256:4f171f959f80",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/classicpress-without-database.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "classicpressDomain",
			"label": "Classicpress domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "classicpress",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "classicpress-files",
					"target": "/var/www/html"
				}
			],
			"files": [],
			"kind": "application",
			"image": "classicpress/classicpress@sha256:4f171f959f80420fd6ef1c46ef4031dcc4f87ed1bf1c97c60d13c17bacbaaaec",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1"
				]
			},
			"public": {
				"port": 80,
				"domain": "classicpressDomain"
			}
		}
	]
}
