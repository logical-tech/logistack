{
	"schema": 1,
	"id": "falkordb",
	"name": "FalkorDB",
	"description": "A high-performance graph database for knowledge graphs, GraphRAG, agent memory, fraud detection and other relationship-heavy workloads. Includes the FalkorDB Browser interface.",
	"category": "database",
	"tags": [
		"database",
		"graph-database",
		"knowledge-graph",
		"graphrag",
		"ai",
		"redis"
	],
	"logo": "logos/falkordb.svg",
	"website": "https://www.falkordb.com/",
	"docs": "https://docs.falkordb.com/",
	"version": "4.20.4",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/falkordb",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "falkordbPassword",
			"label": "Falkordb password",
			"type": "secret",
			"length": 32,
			"charset": "hex"
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "authSecret",
			"label": "Auth secret",
			"type": "base64",
			"bytes": 48
		},
		{
			"key": "encryptionKey",
			"label": "Encryption key",
			"type": "secret",
			"length": 32,
			"charset": "hex"
		}
	],
	"services": [
		{
			"name": "falkordb",
			"dependsOn": [],
			"env": {
				"REDIS_ARGS": "--requirepass ${{ inputs.falkordbPassword }} --appendonly yes",
				"FALKORDB_ARGS": "MAX_QUEUED_QUERIES 25 TIMEOUT 1000 RESULTSET_SIZE 10000 IMPORT_FOLDER /app/.data/import",
				"FALKORDB_PASSWORD": "${{ inputs.falkordbPassword }}",
				"AUTH_URL": "https://${{ inputs.mainDomain }}",
				"AUTH_SECRET": "${{ inputs.authSecret }}",
				"NEXTAUTH_URL": "https://${{ inputs.mainDomain }}",
				"NEXTAUTH_SECRET": "${{ inputs.authSecret }}",
				"ENCRYPTION_KEY": "${{ inputs.encryptionKey }}",
				"ALLOWED_ORIGINS": "https://${{ inputs.mainDomain }}",
				"TRUST_PROXY_HEADERS": "true",
				"CSV_STORAGE": "local",
				"CSV_LOCAL_TEMP_DIR": "/app/.data/import",
				"CSV_LOCAL_LOAD_URI_MODE": "file",
				"API_TOKEN_STORAGE_PATH": "/app/.data/api_tokens.json"
			},
			"volumes": [
				{
					"name": "falkordb-data",
					"target": "/var/lib/falkordb/data"
				},
				{
					"name": "falkordb-browser-data",
					"target": "/app/.data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "falkordb/falkordb:v4.20.4-alpine",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				},
				{
					"target": 6379,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"REDISCLI_AUTH=$FALKORDB_PASSWORD redis-cli ping | grep PONG"
				]
			},
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
