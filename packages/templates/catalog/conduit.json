{
	"schema": 1,
	"id": "conduit",
	"name": "Conduit",
	"description": "Conduit is a simple, fast and reliable chat server powered by Matrix",
	"category": "communication",
	"tags": [
		"matrix",
		"communication"
	],
	"logo": "logos/conduit.svg",
	"website": "https://conduit.rs/",
	"docs": "https://docs.conduit.rs/",
	"version": "v0.9.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/conduit",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "homeserver",
			"dependsOn": [],
			"env": {
				"CONDUIT_SERVER_NAME": "${{ inputs.mainDomain }}",
				"CONDUIT_DATABASE_PATH": "/var/lib/matrix-conduit/",
				"CONDUIT_DATABASE_BACKEND": "rocksdb",
				"CONDUIT_PORT": "6167",
				"CONDUIT_MAX_REQUEST_SIZE": "20000000",
				"CONDUIT_ALLOW_REGISTRATION": "true",
				"CONDUIT_ALLOW_FEDERATION": "true",
				"CONDUIT_ALLOW_CHECK_FOR_UPDATES": "true",
				"CONDUIT_TRUSTED_SERVERS": "[\"matrix.org\"]",
				"CONDUIT_ADDRESS": "0.0.0.0",
				"CONDUIT_CONFIG": ""
			},
			"volumes": [
				{
					"name": "db",
					"target": "/var/lib/matrix-conduit"
				}
			],
			"files": [],
			"kind": "application",
			"image": "registry.gitlab.com/famedly/conduit/matrix-conduit:v0.9.0",
			"ports": [],
			"public": {
				"port": 6167,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
