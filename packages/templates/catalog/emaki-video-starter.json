{
	"schema": 1,
	"id": "emaki-video-starter",
	"name": "Seedance 2.5 Video Generator",
	"description": "One-page text-to-video and image-to-video web app on the Seedance 2.5 API from emaki. Set EMAKI_API_KEY; an access password is generated so only people you share it with can spend your credits.",
	"category": "ai",
	"tags": [
		"ai",
		"video-generation",
		"text-to-video"
	],
	"website": "https://emaki.ai/seedance-2-5",
	"docs": "https://emaki.readthedocs.io/",
	"version": "1.0.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/emaki-video-starter",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "accessPassword",
			"label": "Access password",
			"type": "password",
			"length": 16
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "emaki-video-starter",
			"dependsOn": [],
			"env": {
				"PORT": "3000",
				"EMAKI_API_KEY": "",
				"ACCESS_PASSWORD": "${{ inputs.accessPassword }}",
				"EMAKI_MODEL": "seedance_2_5"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "san8888/emaki-video-starter:1.0.0",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"-qO-",
					"http://127.0.0.1:3000/health"
				]
			},
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
