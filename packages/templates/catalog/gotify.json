{
	"schema": 1,
	"id": "gotify",
	"name": "Gotify",
	"description": "Gotify is a simple server for sending and receiving self-hosted push notifications.",
	"category": "communication",
	"tags": [
		"notifications",
		"self-hosted",
		"push",
		"productivity",
		"notification",
		"collaboration"
	],
	"logo": "logos/gotify.svg",
	"website": "https://gotify.net/",
	"docs": "https://gotify.net/docs/",
	"version": "2.9.1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/gotify",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "gotify",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "gotify-data",
					"target": "/app/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "gotify/server:2.9.1",
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
