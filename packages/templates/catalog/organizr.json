			"image": "organizr/organizr@sha256:703de7b15e3ca0046c9bcfee03c72539f74acc5e26929f2911aa1af2be8ebb01",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"curl -sf http://localhost:80 || exit 1"
				]
			},
			"public": {
				"port": 80,
				"domain": "organizrDomain"
			}
		}
