{
	"schema": 1,
	"id": "organizr",
	"name": "Organizr",
	"description": "Homelab Services Organizer",
	"category": "productivity",
	"tags": [
		"tool"
	],
	"logo": "logos/organizr.png",
	"docs": "https://docs.organizr.app/",
	"version": "sha256:703de7b15e3c",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/organizr.yaml",
