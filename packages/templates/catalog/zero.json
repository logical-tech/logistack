{
	"schema": 1,
	"id": "zero",
	"name": "Zero",
	"description": "Query-driven sync engine for TypeScript apps backed by Postgres.",
	"category": "devtools",
	"tags": [
		"sync",
		"realtime",
		"postgres",
		"typescript",
		"local-first"
	],
	"logo": "logos/zero.svg",
	"docs": "https://zero.rocicorp.dev/docs/deployment",
	"version": "1.6.2",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/zero.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "zeroDomain",
			"label": "Zero domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 64
		},
		{
			"key": "postgresDb",
			"label": "Postgres DB",
			"type": "text",
			"default": ""
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 64
		},
		{
			"key": "zeroQueryUrl",
			"label": "Zero query URL",
			"type": "text"
		},
		{
			"key": "zeroMutateUrl",
			"label": "Zero mutate URL",
			"type": "text"
		}
	],
	"services": [
		{
			"name": "zero",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"ZERO_UPSTREAM_DB": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/${{ inputs.postgresDb }}",
				"ZERO_CVR_DB": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/${{ inputs.postgresDb }}",
				"ZERO_CHANGE_DB": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/${{ inputs.postgresDb }}",
				"ZERO_REPLICA_FILE": "/data/replica.db",
				"ZERO_ADMIN_PASSWORD": "${{ inputs.adminPassword }}",
				"ZERO_QUERY_URL": "${{ inputs.zeroQueryUrl }}",
				"ZERO_MUTATE_URL": "${{ inputs.zeroMutateUrl }}",
				"ZERO_ENABLE_CRUD_MUTATIONS": "false",
				"ZERO_NUM_SYNC_WORKERS": "1",
				"ZERO_APP_ID": "zero",
				"ZERO_LOG_LEVEL": "info",
				"ZERO_ENABLE_TELEMETRY": "true",
				"ZERO_LAZY_STARTUP": "false",
				"ZERO_QUERY_API_KEY": "",
				"ZERO_MUTATE_API_KEY": ""
			},
			"volumes": [
				{
					"name": "zero-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "rocicorp/zero:1.6.2",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:4848/keepalive"
				]
			},
			"public": {
				"port": 4848,
				"domain": "zeroDomain"
			}
		},
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "zero-db"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "postgres:18-alpine",
			"command": [
				"postgres",
				"-c",
				"wal_level=logical"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"
				]
			}
		}
	]
}
