{
	"schema": 1,
	"id": "termix",
	"name": "Termix",
	"description": "All-in-One SSH & Remote Desktop management app.",
	"category": "devtools",
	"tags": [
		"ssh",
		"terminal",
		"remote-desktop",
		"rdp",
		"vnc",
		"server-management",
		"remote-access"
	],
	"logo": "logos/termix.svg",
	"docs": "https://docs.termix.site/install/server/docker",
	"version": "2.6.1",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/termix.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "termixDomain",
			"label": "Termix domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "termix",
			"dependsOn": [
				"guacd"
			],
			"env": {
				"PORT": "8080",
				"LOG_LEVEL": "info",
				"GUACD_HOST": "${{ services.guacd.host }}",
				"GUACD_RECORDING_PATH": "/termix-data/session_recordings/guacamole"
			},
			"volumes": [
				{
					"name": "termix-data",
					"target": "/app/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/lukegus/termix:2.6.1",
			"ports": [],
			"public": {
				"port": 8080,
				"domain": "termixDomain"
			}
		},
		{
			"name": "guacd",
			"dependsOn": [],
			"env": {},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "guacamole/guacd:1.6.0",
			"ports": []
		}
	]
}
