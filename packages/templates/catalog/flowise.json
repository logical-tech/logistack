{
	"schema": 1,
	"id": "flowise",
	"name": "Flowise",
	"description": "Flowise is an open source low-code tool for developers to build customized LLM orchestration flows & AI agents.",
	"category": "ai",
	"tags": [
		"lowcode",
		"nocode",
		"ai",
		"llm",
		"openai",
		"anthropic",
		"machine-learning",
		"rag",
		"agents",
		"chatbot",
		"api",
		"team",
		"bot",
		"flows"
	],
	"logo": "logos/flowise.png",
	"docs": "https://docs.flowiseai.com/",
	"version": "sha256:cf880b17b129",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/flowise.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "flowiseDomain",
			"label": "Flowise domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "flowiseUser",
			"label": "Flowise user",
			"type": "username"
		},
		{
			"key": "flowisePassword",
			"label": "Flowise password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "flowise",
			"dependsOn": [],
			"env": {
				"DEBUG": "false",
				"DISABLE_FLOWISE_TELEMETRY": "true",
				"PORT": "3001",
				"DATABASE_PATH": "/root/.flowise",
				"APIKEY_PATH": "/root/.flowise",
				"SECRETKEY_PATH": "/root/.flowise",
				"LOG_PATH": "/root/.flowise/logs",
				"BLOB_STORAGE_PATH": "/root/.flowise/storage",
				"FLOWISE_USERNAME": "${{ inputs.flowiseUser }}",
				"FLOWISE_PASSWORD": "${{ inputs.flowisePassword }}"
			},
			"volumes": [
				{
					"name": "flowise-data",
					"target": "/root/.flowise"
				}
			],
			"files": [],
			"kind": "application",
			"image": "flowiseai/flowise@sha256:cf880b17b1290fbaebebc76c33954bde67b3775aff95feec72a1d060cc81e43d",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget -qO- http://127.0.0.1:3001 || exit 1"
				]
			},
			"public": {
				"port": 3001,
				"domain": "flowiseDomain"
			}
		}
	]
}
