{
	"schema": 1,
	"id": "paperclip",
	"name": "Paperclip",
	"description": "Paperclip is an open-source control plane for managing teams of AI agents, goals, budgets, tickets, and recurring work.",
	"category": "ai",
	"tags": [
		"ai",
		"agents",
		"automation",
		"self-hosted"
	],
	"logo": "logos/paperclip.svg",
	"website": "https://paperclip.ing/",
	"docs": "https://docs.paperclip.ing/",
	"version": "sha256:40f46940c461",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/paperclip",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "betterAuthSecret",
			"label": "Better auth secret",
			"type": "password",
			"length": 64
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "paperclip",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "paperclip"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "17-alpine"
		},
		{
			"name": "paperclip",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"HOST": "0.0.0.0",
				"PORT": "3100",
				"SERVE_UI": "true",
				"DATABASE_URL": "postgres://paperclip:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/paperclip",
				"BETTER_AUTH_SECRET": "${{ inputs.betterAuthSecret }}",
				"PAPERCLIP_HOME": "/paperclip",
				"PAPERCLIP_INSTANCE_ID": "default",
				"PAPERCLIP_CONFIG": "/paperclip/instances/default/config.json",
				"PAPERCLIP_DEPLOYMENT_MODE": "authenticated",
				"PAPERCLIP_DEPLOYMENT_EXPOSURE": "private",
				"PAPERCLIP_PUBLIC_URL": "https://${{ inputs.mainDomain }}"
			},
			"volumes": [
				{
					"name": "paperclip-data",
					"target": "/paperclip"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/paperclipai/paperclip@sha256:40f46940c4612ead131aebe6079cd4651f8cd1434af49f7c621887f4a452a62e",
			"ports": [
				{
					"target": 3100,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3100,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
