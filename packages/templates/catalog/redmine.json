{
	"schema": 1,
	"id": "redmine",
	"name": "Redmine",
	"description": "Redmine is a flexible project management web application.",
	"category": "productivity",
	"tags": [
		"redmine",
		"project management"
	],
	"logo": "logos/redmine.svg",
	"docs": "https://www.redmine.org/",
	"version": "6-alpine",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/redmine.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "redmineDomain",
			"label": "Redmine domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "redminePassword",
			"label": "Redmine password",
			"type": "password",
			"length": 64
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 64
		}
	],
	"services": [
		{
			"name": "redmine",
			"dependsOn": [
				"postgresql"
			],
			"env": {
				"SECRET_KEY_BASE": "${{ inputs.redminePassword }}",
				"REDMINE_DB_POSTGRES": "postgresql",
				"REDMINE_DB_PORT": "5432",
				"REDMINE_DB_USERNAME": "${{ inputs.postgresUser }}",
				"REDMINE_DB_PASSWORD": "${{ inputs.postgresPassword }}",
				"REDMINE_DB_DATABASE": "redmine-db"
			},
			"volumes": [
				{
					"name": "redmine-config",
					"target": "/usr/src/redmine/config"
				},
				{
					"name": "redmine-files",
					"target": "/usr/src/redmine/files"
				},
				{
					"name": "redmine-themes",
					"target": "/usr/src/redmine/themes"
				},
				{
					"name": "redmine-plugins",
					"target": "/usr/src/redmine/plugins"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redmine:6-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget -qO- http://127.0.0.1:3000/"
				]
			},
			"public": {
				"port": 3000,
				"domain": "redmineDomain"
			}
		},
		{
			"name": "postgresql",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "redmine-db"
			},
			"volumes": [
				{
					"name": "postgresql-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "17-alpine"
		}
	]
}
