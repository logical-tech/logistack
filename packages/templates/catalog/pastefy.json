{
	"schema": 1,
	"id": "pastefy",
	"name": "Pastefy",
	"description": "Pastefy is an open-source pastebin with support for syntax highlighting and OAuth2 authentication.",
	"category": "productivity",
	"tags": [
		"pastebin",
		"text-sharing",
		"collaboration",
		"oauth2"
	],
	"logo": "logos/pastefy.png",
	"website": "https://pastefy.app/",
	"docs": "https://github.com/interaapps/pastefy/wiki",
	"version": "sha256:d2abe24232aa",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/pastefy",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "dbRootPassword",
			"label": "DB root password",
			"type": "password",
			"length": 32
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.dbRootPassword }}",
				"MYSQL_DATABASE": "pastefy",
				"MYSQL_USER": "pastefy",
				"MYSQL_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "files-db",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mariadb:10.11",
			"ports": [],
			"restart": "any"
		},
		{
			"name": "pastefy",
			"dependsOn": [
				"db"
			],
			"env": {
				"HTTP_SERVER_PORT": "80",
				"HTTP_SERVER_CORS": "*",
				"DATABASE_DRIVER": "mysql",
				"DATABASE_NAME": "pastefy",
				"DATABASE_USER": "pastefy",
				"DATABASE_PASSWORD": "${{ inputs.dbPassword }}",
				"DATABASE_HOST": "${{ services.db.host }}",
				"DATABASE_PORT": "3306",
				"SERVER_NAME": "https://${{ inputs.mainDomain }}",
				"OAUTH2_INTERAAPPS_CLIENT_ID": "NONE # Interaapps API Key (optional)",
				"OAUTH2_INTERAAPPS_CLIENT_SECRET": " # Interaapps API Secret (optional)",
				"OAUTH2_GITHUB_CLIENT_ID": "NONE # GitHub API Key (optional)",
				"OAUTH2_GITHUB_CLIENT_SECRET": " # GitHub API Secret (optional)",
				"OAUTH2_GOOGLE_CLIENT_ID": "NONE # Google API Key (optional)",
				"OAUTH2_GOOGLE_CLIENT_SECRET": " # Google API Secret (optional)",
				"OAUTH2_DISCORD_CLIENT_ID": "NONE # Discord API Key (optional)",
				"OAUTH2_DISCORD_CLIENT_SECRET": " # Discord API Secret (optional)",
				"OAUTH2_TWITCH_CLIENT_ID": "NONE # Twitch API Key (optional)",
				"OAUTH2_TWITCH_CLIENT_SECRET": " # Twitch API Secret (optional)"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "interaapps/pastefy@sha256:d2abe24232aa54023c472b033fe50cc8db0df8769bbe8099575d2bdaeed3ecb0",
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
