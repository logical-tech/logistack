{
	"schema": 1,
	"id": "yamtrack-with-postgresql",
	"name": "Yamtrack With Postgresql",
	"description": "Yamtrack is a self hosted media tracker for movies, tv shows, anime, manga, video games and books.",
	"category": "productivity",
	"tags": [
		"self-hosted",
		"automation",
		"tracker",
		"media",
		"movies",
		"shows",
		"anime",
		"manga",
		"games",
		"books",
		"comics"
	],
	"logo": "logos/yamtrack-with-postgresql.svg",
	"docs": "https://github.com/FuzzyGrim/Yamtrack/wiki",
	"version": "sha256:78497b454b2b",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/yamtrack-with-postgresql.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "yamtrackDomain",
			"label": "Yamtrack domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "secretPassword",
			"label": "Secret password",
			"type": "password",
			"length": 32
		},
		{
			"key": "postgresqlUser",
			"label": "Postgresql user",
			"type": "username"
		},
		{
			"key": "postgresqlPassword",
			"label": "Postgresql password",
			"type": "password",
			"length": 32
		},
		{
			"key": "timezone",
			"label": "Timezone",
			"description": "IANA time zone, for example Europe/Rome.",
			"type": "text",
			"default": "UTC"
		}
	],
	"services": [
		{
			"name": "yamtrack",
			"dependsOn": [
				"postgres",
				"redis"
			],
			"env": {
				"URLS": "https://${{ inputs.yamtrackDomain }}",
				"TZ": "${{ inputs.timezone }}",
				"SECRET": "${{ inputs.secretPassword }}",
				"REGISTRATION": "true",
				"REDIS_URL": "redis://${{ services.redis.host }}:6379",
				"DB_HOST": "${{ services.postgres.host }}",
				"DB_NAME": "yamtrack-db",
				"DB_USER": "${{ inputs.postgresqlUser }}",
				"DB_PASSWORD": "${{ inputs.postgresqlPassword }}",
				"DB_PORT": "5432"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/fuzzygrim/yamtrack@sha256:78497b454b2b52d3b1062f6fd238351d714cff0895db4369e49ace36f4622e75",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"--no-verbose",
					"--tries=1",
					"--spider",
					"http://127.0.0.1:8000/health/"
				]
			},
			"public": {
				"port": 8000,
				"domain": "yamtrackDomain"
			}
		},
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresqlUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresqlPassword }}",
				"POSTGRES_DB": "yamtrack-db"
			},
			"volumes": [
				{
					"name": "yamtrack-postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		},
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "yamtrack-redis-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redis:7-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"redis-cli",
					"ping"
				]
			}
		}
	]
}
