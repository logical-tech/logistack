{
	"schema": 1,
	"id": "linkding-plus",
	"name": "Linkding Plus",
	"description": "A self-hosted bookmark manager designed to be minimal, fast, and easy to set up. (Includes feature for archiving websites as HTML snapshots)",
	"category": "communication",
	"tags": [
		"rss",
		"feed"
	],
	"logo": "logos/linkding-plus.svg",
	"docs": "https://linkding.link/",
	"version": "latest-plus",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/linkding-plus.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "linkdingDomain",
			"label": "Linkding domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "linkdingUser",
			"label": "Linkding user",
			"type": "username"
		},
		{
			"key": "linkdingPassword",
			"label": "Linkding password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "linkding-plus",
			"dependsOn": [],
			"env": {
				"LD_SUPERUSER_NAME": "${{ inputs.linkdingUser }}",
				"LD_SUPERUSER_PASSWORD": "${{ inputs.linkdingPassword }}"
			},
			"volumes": [
				{
					"name": "linkding-data",
					"target": "/etc/linkding/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "sissbruecker/linkding:latest-plus",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"bash -c ':> /dev/tcp/127.0.0.1/9090' || exit 1"
				]
			},
			"public": {
				"port": 9090,
				"domain": "linkdingDomain"
			}
		}
	]
}
