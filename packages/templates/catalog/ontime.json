{
	"schema": 1,
	"id": "ontime",
	"name": "Ontime",
	"description": "Ontime is browser-based application that manages event rundowns, scheduliing and cuing",
	"category": "other",
	"tags": [
		"event"
	],
	"logo": "logos/ontime.png",
	"website": "https://getontime.no/",
	"docs": "https://docs.getontime.no/",
	"version": "v3.8.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/ontime",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "ontime",
			"dependsOn": [],
			"env": {
				"TZ": "UTC"
			},
			"volumes": [
				{
					"name": "ontime-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "getontime/ontime:v3.8.0",
			"ports": [
				{
					"target": 4001,
					"protocol": "tcp"
				},
				{
					"target": 8888,
					"protocol": "tcp"
				},
				{
					"target": 9999,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 4001,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
