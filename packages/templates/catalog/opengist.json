{
	"schema": 1,
	"id": "opengist",
	"name": "OpenGist",
	"description": "OpenGist is a self-hosted pastebin alternative.",
	"category": "other",
	"tags": [
		"pastebin",
		"code",
		"snippets",
		"self-hosted"
	],
	"logo": "logos/opengist.svg",
	"website": "https://github.com/thomiceli/opengist",
	"docs": "https://github.com/thomiceli/opengist",
	"version": "1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/opengist",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "opengist",
			"dependsOn": [],
			"env": {
				"UID": "1001",
				"GID": "1001",
				"OG_LOG_LEVEL": "info"
			},
			"volumes": [
				{
					"name": "opengist-data",
					"target": "/opengist"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/thomiceli/opengist:1",
			"ports": [
				{
					"target": 6157,
					"protocol": "tcp"
				},
				{
					"target": 2222,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 6157,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
