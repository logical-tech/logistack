{
	"schema": 1,
	"id": "filestash",
	"name": "Filestash",
	"description": "Filestash is the enterprise-grade file manager connecting your storage with your identity provider and authorisations.",
	"category": "other",
	"tags": [
		"file-manager",
		"document-editor",
		"self-hosted"
	],
	"logo": "logos/filestash.svg",
	"website": "https://www.filestash.app/",
	"docs": "https://www.filestash.app/docs/",
	"version": "sha256:97572d47f912",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/filestash",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "app",
			"dependsOn": [],
			"env": {
				"APPLICATION_URL": "${{ inputs.mainDomain }}",
				"CANARY": "true",
				"OFFICE_URL": "http://${{ services.wopi-server.host }}:9980",
				"OFFICE_FILESTASH_URL": "http://${{ services.app.host }}:8334",
				"OFFICE_REWRITE_URL": "http://127.0.0.1:9980"
			},
			"volumes": [
				{
					"name": "filestash",
					"target": "/app/data/state"
				}
			],
			"files": [],
			"kind": "application",
			"image": "machines/filestash@sha256:97572d47f912777daba7f25ff072b4423f9a5e4fc6ae291554376f004d429618",
			"ports": [
				{
					"target": 8334,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8334,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "wopi-server",
			"dependsOn": [],
			"env": {
				"extra_params": "--o:ssl.enable=false",
				"aliasgroup1": "https://.*:443"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "collabora/code:24.04.10.2.1",
			"command": [
				"/bin/bash",
				"-c",
				"curl -o /usr/share/coolwsd/browser/dist/branding-desktop.css https://gist.githubusercontent.com/mickael-kerjean/bc1f57cd312cf04731d30185cc4e7ba2/raw/d706dcdf23c21441e5af289d871b33defc2770ea/destop.css\n/bin/su -s /bin/bash -c '/start-collabora-online.sh' cool\n"
			],
			"ports": [
				{
					"target": 9980,
					"protocol": "tcp"
				}
			],
			"user": "0",
			"restart": "any"
		}
	]
}
