{
	"schema": 1,
	"id": "novu",
	"name": "Novu",
	"description": "Open-source notification infrastructure for multi-channel workflows — in-app Inbox, email, SMS, push, and chat — with a unified API and dashboard.",
	"category": "communication",
	"tags": [
		"notifications",
		"email",
		"sms",
		"push",
		"inbox",
		"self-hosted",
		"api"
	],
	"logo": "logos/novu.png",
	"website": "https://novu.co/",
	"docs": "https://docs.novu.co/community/self-hosting-novu/deploy-with-docker",
	"version": "3.18.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/novu",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "jwtSecret",
			"label": "JWT secret",
			"type": "password",
			"length": 64
		},
		{
			"key": "storeEncryptionKey",
			"label": "Store encryption key",
			"type": "password",
			"length": 32
		},
		{
			"key": "novuSecretKey",
			"label": "Novu secret key",
			"type": "password",
			"length": 64
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "apiDomain",
			"label": "API domain",
			"type": "domain",
			"role": "extra"
		},
		{
			"key": "wsDomain",
			"label": "Ws domain",
			"type": "domain",
			"role": "extra"
		},
		{
			"key": "mongoPassword",
			"label": "Mongo password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "novu-redis",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redis:7-alpine",
			"command": [
				"redis-server",
				"--appendonly",
				"yes"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"redis-cli",
					"ping"
				]
			},
			"restart": "any"
		},
		{
			"name": "mongodb",
			"dependsOn": [],
			"env": {
				"MONGO_INITDB_ROOT_USERNAME": "root",
				"MONGO_INITDB_ROOT_PASSWORD": "${{ inputs.mongoPassword }}"
			},
			"volumes": [
				{
					"name": "novu-mongodb",
					"target": "/data/db"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mongo",
			"version": "8.0.17"
		},
		{
			"name": "api",
			"dependsOn": [
				"mongodb",
				"redis"
			],
			"env": {
				"NODE_ENV": "production",
				"API_ROOT_URL": "https://${{ inputs.apiDomain }}",
				"PORT": "3000",
				"FRONT_BASE_URL": "https://${{ inputs.mainDomain }}",
				"MONGO_URL": "mongodb://root:${{ inputs.mongoPassword }}@${{ services.mongodb.host }}:27017/novu-db?authSource=admin",
				"MONGO_MIN_POOL_SIZE": "5",
				"MONGO_MAX_POOL_SIZE": "10",
				"MONGO_AUTO_CREATE_INDEXES": "true",
				"REDIS_HOST": "${{ services.redis.host }}",
				"REDIS_PORT": "6379",
				"REDIS_PASSWORD": "",
				"REDIS_DB_INDEX": "2",
				"REDIS_CACHE_SERVICE_HOST": "${{ services.redis.host }}",
				"REDIS_CACHE_SERVICE_PORT": "6379",
				"S3_LOCAL_STACK": "",
				"S3_BUCKET_NAME": "novu-local",
				"S3_REGION": "us-east-1",
				"AWS_ACCESS_KEY_ID": "test",
				"AWS_SECRET_ACCESS_KEY": "test",
				"JWT_SECRET": "${{ inputs.jwtSecret }}",
				"STORE_ENCRYPTION_KEY": "${{ inputs.storeEncryptionKey }}",
				"NOVU_SECRET_KEY": "${{ inputs.novuSecretKey }}",
				"SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME": "15d",
				"SENTRY_DSN": "",
				"NEW_RELIC_ENABLED": "false",
				"NEW_RELIC_APP_NAME": "",
				"NEW_RELIC_LICENSE_KEY": "",
				"API_CONTEXT_PATH": "",
				"IS_API_IDEMPOTENCY_ENABLED": "false",
				"IS_API_RATE_LIMITING_ENABLED": "false",
				"IS_NEW_MESSAGES_API_RESPONSE_ENABLED": "true",
				"IS_V2_ENABLED": "true",
				"IS_SELF_HOSTED": "true"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/novuhq/novu/api:3.18.0",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget --no-verbose --tries=1 --spider http://localhost:${PORT}/v1/health-check || exit 1"
				]
			},
			"public": {
				"port": 3000,
				"domain": "apiDomain"
			},
			"restart": "any"
		},
		{
			"name": "worker",
			"dependsOn": [
				"mongodb",
				"redis"
			],
			"env": {
				"NODE_ENV": "production",
				"PORT": "3004",
				"MONGO_URL": "mongodb://root:${{ inputs.mongoPassword }}@${{ services.mongodb.host }}:27017/novu-db?authSource=admin",
				"MONGO_MIN_POOL_SIZE": "5",
				"MONGO_MAX_POOL_SIZE": "10",
				"REDIS_HOST": "${{ services.redis.host }}",
				"REDIS_PORT": "6379",
				"REDIS_PASSWORD": "",
				"REDIS_DB_INDEX": "2",
				"REDIS_CACHE_SERVICE_HOST": "${{ services.redis.host }}",
				"REDIS_CACHE_SERVICE_PORT": "6379",
				"S3_LOCAL_STACK": "",
				"S3_BUCKET_NAME": "novu-local",
				"S3_REGION": "us-east-1",
				"AWS_ACCESS_KEY_ID": "test",
				"AWS_SECRET_ACCESS_KEY": "test",
				"STORE_ENCRYPTION_KEY": "${{ inputs.storeEncryptionKey }}",
				"SUBSCRIBER_WIDGET_JWT_EXPIRATION_TIME": "15d",
				"SENTRY_DSN": "",
				"NEW_RELIC_ENABLED": "false",
				"NEW_RELIC_APP_NAME": "",
				"NEW_RELIC_LICENSE_KEY": "",
				"BROADCAST_QUEUE_CHUNK_SIZE": "100",
				"MULTICAST_QUEUE_CHUNK_SIZE": "100",
				"API_ROOT_URL": "http://${{ services.api.host }}:3000",
				"IS_EMAIL_INLINE_CSS_DISABLED": "false",
				"IS_USE_MERGED_DIGEST_ID_ENABLED": "false"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/novuhq/novu/worker:3.18.0",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3004}/v1/health-check || exit 1"
				]
			},
			"restart": "any"
		},
		{
			"name": "ws",
			"dependsOn": [
				"mongodb",
				"redis"
			],
			"env": {
				"PORT": "3002",
				"NODE_ENV": "production",
				"MONGO_URL": "mongodb://root:${{ inputs.mongoPassword }}@${{ services.mongodb.host }}:27017/novu-db?authSource=admin",
				"MONGO_MIN_POOL_SIZE": "5",
				"MONGO_MAX_POOL_SIZE": "10",
				"REDIS_HOST": "${{ services.redis.host }}",
				"REDIS_PORT": "6379",
				"REDIS_PASSWORD": "",
				"JWT_SECRET": "${{ inputs.jwtSecret }}",
				"WS_CONTEXT_PATH": "",
				"NEW_RELIC_ENABLED": "false",
				"NEW_RELIC_APP_NAME": "",
				"NEW_RELIC_LICENSE_KEY": ""
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/novuhq/novu/ws:3.18.0",
			"ports": [
				{
					"target": 3002,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget --no-verbose --tries=1 --spider http://localhost:${PORT}/v1/health-check || exit 1"
				]
			},
			"public": {
				"port": 3002,
				"domain": "wsDomain"
			},
			"restart": "any"
		},
		{
			"name": "novu",
			"dependsOn": [
				"api",
				"worker"
			],
			"env": {
				"VITE_API_HOSTNAME": "https://${{ inputs.apiDomain }}",
				"VITE_WEBSOCKET_HOSTNAME": "https://${{ inputs.wsDomain }}"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/novuhq/novu/dashboard:3.18.0",
			"ports": [
				{
					"target": 4000,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"node -e \"const http = require('http'); const req = http.get({hostname: 'localhost', port: 4000, path: '/', timeout: 5000}, (res) => { process.exit(res.statusCode === 200 ? 0 : 1); }); req.on('error', () => process.exit(1)); req.on('timeout', () => { req.destroy(); process.exit(1); });\""
				]
			},
			"public": {
				"port": 4000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
