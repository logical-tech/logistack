{
	"schema": 1,
	"id": "kitchenowl",
	"name": "KitchenOwl",
	"description": "KitchenOwl is a self-hosted grocery list and recipe manager.",
	"category": "other",
	"tags": [
		"self-hosted",
		"recipes",
		"grocery",
		"personal"
	],
	"logo": "logos/kitchenowl.png",
	"website": "https://kitchenowl.org/",
	"docs": "https://github.com/TomBursch/kitchenowl/wiki",
	"version": "v0.7.1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/kitchenowl",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "appPassword",
			"label": "App password",
			"type": "password",
			"length": 32
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 24
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "web",
			"dependsOn": [
				"db"
			],
			"env": {
				"JWT_SECRET_KEY": "${{ inputs.appPassword }}",
				"DB_DRIVER": "postgresql",
				"DB_HOST": "${{ services.db.host }}",
				"DB_NAME": "kitchenowl",
				"DB_USER": "kitchenowl",
				"DB_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "kitchenowl-files",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "tombursch/kitchenowl:v0.7.1",
			"ports": [],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "db",
			"dependsOn": [],
			"env": {
				"POSTGRES_DB": "kitchenowl",
				"POSTGRES_USER": "kitchenowl",
				"POSTGRES_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "kitchenowl-db",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "17"
		}
	]
}
