{
	"schema": 1,
	"id": "pretix",
	"name": "Pretix",
	"description": "Ticket shop application for conferences, festivals, concerts, tech events, shows, workshops, etc.",
	"category": "other",
	"tags": [
		"ticketing",
		"events",
		"e-commerce"
	],
	"logo": "logos/pretix.svg",
	"website": "https://pretix.eu/",
	"docs": "https://docs.pretix.eu/",
	"version": "2026.8.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/pretix",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "secretKey",
			"label": "Secret key",
			"type": "password",
			"length": 64
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "pretix",
			"dependsOn": [
				"postgres",
				"redis"
			],
			"env": {
				"PRETIX_PRETIX_INSTANCE_NAME": "pretix",
				"PRETIX_PRETIX_URL": "https://${{ inputs.mainDomain }}",
				"PRETIX_PRETIX_CURRENCY": "EUR",
				"PRETIX_PRETIX_DATADIR": "/data",
				"PRETIX_PRETIX_TRUST_X_FORWARDED_FOR": "on",
				"PRETIX_PRETIX_TRUST_X_FORWARDED_PROTO": "on",
				"PRETIX_DJANGO_SECRET": "${{ inputs.secretKey }}",
				"PRETIX_DATABASE_BACKEND": "postgresql",
				"PRETIX_DATABASE_NAME": "pretix",
				"PRETIX_DATABASE_USER": "pretix",
				"PRETIX_DATABASE_PASSWORD": "${{ inputs.postgresPassword }}",
				"PRETIX_DATABASE_HOST": "${{ services.postgres.host }}",
				"PRETIX_DATABASE_PORT": "5432",
				"PRETIX_REDIS_LOCATION": "redis://${{ services.redis.host }}:6379/0",
				"PRETIX_REDIS_SESSIONS": "true",
				"PRETIX_CELERY_BACKEND": "redis://${{ services.redis.host }}:6379/1",
				"PRETIX_CELERY_BROKER": "redis://${{ services.redis.host }}:6379/2",
				"PRETIX_MAIL_FROM": "tickets@example.com",
				"PRETIX_MAIL_HOST": "localhost",
				"PRETIX_MAIL_PORT": "25",
				"PRETIX_MAIL_USER": "",
				"PRETIX_MAIL_PASSWORD": "",
				"PRETIX_MAIL_TLS": "false"
			},
			"volumes": [
				{
					"name": "pretix-data",
					"target": "/data"
				},
				{
					"name": "pretix-config",
					"target": "/etc/pretix"
				}
			],
			"files": [],
			"kind": "application",
			"image": "pretix/standalone:2026.8.0",
			"command": [
				"all"
			],
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "pretix",
				"POSTGRES_DB": "pretix",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}"
			},
			"volumes": [
				{
					"name": "pretix-postgres",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		},
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "pretix-redis",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redis:7-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"redis-cli",
					"ping"
				]
			},
			"restart": "any"
		}
	]
}
