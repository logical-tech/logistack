{
	"schema": 1,
	"id": "overseerr",
	"name": "Overseerr",
	"description": "Overseerr is a request management and media discovery tool built to work with your existing Plex ecosystem.",
	"category": "media",
	"tags": [
		"media",
		"request",
		"plex",
		"sonarr",
		"radarr"
	],
	"logo": "logos/overseerr.svg",
	"docs": "https://docs.overseerr.dev/getting-started/installation#docker",
	"version": "sha256:6197516c9d7b",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/overseerr.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "overseerrDomain",
			"label": "Overseerr domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "timezone",
			"label": "Timezone",
			"description": "IANA time zone, for example Europe/Rome.",
			"type": "text",
			"default": "UTC"
		}
	],
	"services": [
		{
			"name": "overseerr",
			"dependsOn": [],
			"env": {
				"PUID": "1000",
				"PGID": "1000",
				"TZ": "${{ inputs.timezone }}"
			},
			"volumes": [
				{
					"name": "overseerr-config",
					"target": "/app/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "sctx/overseerr@sha256:6197516c9d7b58ccf113455e32aafb94df5d91995fe50e8c2cae6ba6c7c7b7de",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"--tries",
					"1",
					"--no-verbose",
					"--spider",
					"http://localhost:5055/api/v1/status"
				]
			},
			"public": {
				"port": 5055,
				"domain": "overseerrDomain"
			}
		}
	]
}
