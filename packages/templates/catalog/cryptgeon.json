{
	"schema": 1,
	"id": "cryptgeon",
	"name": "Cryptgeon",
	"description": "Secure note / file sharing service inspired by PrivNote.",
	"category": "security",
	"tags": [
		"cryptgeon",
		"secure",
		"note",
		"sharing",
		"privnote",
		"file"
	],
	"docs": "https://github.com/cupcakearmy/cryptgeon",
	"version": "sha256:0344b34ba537",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/cryptgeon.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "cryptgeonDomain",
			"label": "Cryptgeon domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "app",
			"dependsOn": [
				"redis"
			],
			"env": {
				"SIZE_LIMIT": "4 MiB",
				"MAX_VIEWS": "100",
				"MAX_EXPIRATION": "360",
				"ALLOW_ADVANCED": "true",
				"ALLOW_FILES": "true"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "cupcakearmy/cryptgeon@sha256:0344b34ba5375b9cb5bc6740fd35d075d2a581ddb0fcd30e0494c62ba3408e87",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"--fail",
					"http://127.0.0.1:8000/api/live/"
				]
			},
			"public": {
				"port": 8000,
				"domain": "cryptgeonDomain"
			}
		},
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "redis:7-alpine",
			"command": [
				"redis-server",
				"--maxmemory",
				"200mb",
				"--maxmemory-policy",
				"allkeys-lru"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"redis-cli",
					"PING"
				]
			}
		}
	]
}
