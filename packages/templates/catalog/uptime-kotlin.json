{
	"schema": 1,
	"id": "uptime-kotlin",
	"name": "Uptime Kotlin",
	"description": "Uptime Kotlin is an open-source monitoring tool that tracks the uptime of your websites and services.",
	"category": "monitoring",
	"tags": [
		"monitoring"
	],
	"website": "https://uptime-kotlin.com/",
	"docs": "https://uptime-kotlin.com/docs",
	"version": "1.5.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/uptime-kotlin",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		},
		{
			"key": "encryptionKey",
			"label": "Encryption key",
			"type": "base64",
			"bytes": 64
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "uptime-kotlin",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"TZ": "Europe/Paris",
				"QUARKUS_DATASOURCE_USERNAME": "uptime-kotlin",
				"QUARKUS_DATASOURCE_PASSWORD": "${{ inputs.dbPassword }}",
				"QUARKUS_DATASOURCE_JDBC_URL": "jdbc:postgresql://${{ services.postgres.host }}:5432/uptime-kotlin",
				"ENCRYPTION_MASTER_KEY": "${{ inputs.encryptionKey }}",
				"MP_JWT_VERIFY_ISSUER": "https://${{ inputs.mainDomain }}/"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/theomeunier/uptime-kotlin:1.5.0",
			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any",
			"resources": {
				"memoryMb": 512
			}
		},
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_DB": "uptime-kotlin",
				"POSTGRES_USER": "uptime-kotlin",
				"POSTGRES_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "uptime-kotlin-db",
					"target": "/var/lib/postgresql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "postgres:18.6-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"pg_isready -U uptime-kotlin -d uptime-kotlin"
				]
			},
			"restart": "any"
		}
	]
}
