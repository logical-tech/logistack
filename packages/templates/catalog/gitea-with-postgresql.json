{
	"schema": 1,
	"id": "gitea-with-postgresql",
	"name": "Gitea With Postgresql",
	"description": "Gitea is a self-hosted, lightweight Git service, offering version control, collaboration, and code hosting.",
	"category": "devtools",
	"tags": [
		"version control",
		"collaboration",
		"code",
		"hosting",
		"lightweight",
		"postgresql"
	],
	"logo": "logos/gitea-with-postgresql.svg",
	"docs": "https://docs.gitea.com/",
	"version": "sha256:8967bf9deaf3",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/gitea-with-postgresql.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "giteaDomain",
			"label": "Gitea domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresqlUser",
			"label": "Postgresql user",
			"type": "username"
		},
		{
			"key": "postgresqlPassword",
			"label": "Postgresql password",
			"type": "password",
			"length": 32
		},
		{
			"key": "postgresqlDatabase",
			"label": "Postgresql database",
			"type": "text",
			"default": ""
		}
	],
	"services": [
		{
			"name": "gitea",
			"dependsOn": [
				"postgresql"
			],
			"env": {
				"USER_UID": "1000",
				"USER_GID": "1000",
				"GITEA__database__DB_TYPE": "postgres",
				"GITEA__database__HOST": "${{ services.postgresql.host }}",
				"GITEA__database__NAME": "gitea",
				"GITEA__database__USER": "${{ inputs.postgresqlUser }}",
				"GITEA__database__PASSWD": "${{ inputs.postgresqlPassword }}"
			},
			"volumes": [
				{
					"name": "gitea-data",
					"target": "/data"
				},
				{
					"name": "gitea-timezone",
					"target": "/etc/timezone",
					"readOnly": true
				},
				{
					"name": "gitea-localtime",
					"target": "/etc/localtime",
					"readOnly": true
				}
			],
			"files": [],
			"kind": "application",
			"image": "gitea/gitea@sha256:8967bf9deaf3c5c4adae13519436dc1b20c646ac83fe37ae810c933a1045227d",
			"ports": [
				{
					"target": 22,
					"published": 22222,
					"protocol": "tcp",
					"mode": "host"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:3000"
				]
			},
			"public": {
				"port": 3000,
				"domain": "giteaDomain"
			}
		},
		{
			"name": "postgresql",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresqlUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresqlPassword }}",
				"POSTGRES_DB": "${{ inputs.postgresqlDatabase }}"
			},
			"volumes": [
				{
					"name": "gitea-postgresql-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		}
	]
}
