{
	"schema": 1,
	"id": "gitea-mirror",
	"name": "Gitea Mirror",
	"description": "Gitea Mirror is a modern web app for automatically mirroring repositories from GitHub to your self-hosted Gitea instance. It features a user-friendly interface to sync public, private, or starred GitHub repos, mirror entire organizations with structure preservation, and optionally mirror issues and labels. The application includes smart filtering, detailed logs, and scheduled automatic mirroring.",
	"category": "devtools",
	"tags": [
		"git",
		"mirror",
		"github",
		"gitea",
		"self-hosted",
		"automation"
	],
	"logo": "logos/gitea-mirror.png",
	"website": "https://github.com/arunavo4/gitea-mirror",
	"docs": "https://github.com/arunavo4/gitea-mirror#readme",
	"version": "v2.11.2",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/gitea-mirror",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "betterAuthSecret",
			"label": "Better auth secret",
			"type": "base64",
			"bytes": 64
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "gitea-mirror",
			"dependsOn": [],
			"env": {
				"BETTER_AUTH_SECRET": "${{ inputs.betterAuthSecret }}",
				"BETTER_AUTH_URL": "https://${{ inputs.mainDomain }}",
				"NODE_ENV": "production",
				"DATABASE_URL": "file:data/gitea-mirror.db",
				"HOST": "0.0.0.0",
				"PORT": "4321"
			},
			"volumes": [
				{
					"name": "gitea-mirror-data",
					"target": "/app/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/raylabshq/gitea-mirror@sha256:755b6e3b3d63a00c247096e67ac8438f65cba2233ddee5e88e8c9763dc230a06",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"--no-verbose",
					"--tries=3",
					"--spider",
					"http://localhost:4321/api/health"
				]
			},
			"public": {
				"port": 4321,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
