{
	"schema": 1,
	"id": "formbricks",
	"name": "Formbricks",
	"description": "Formbricks is an open-source survey platform for collecting user and customer feedback.",
	"category": "analytics",
	"tags": [
		"forms",
		"analytics"
	],
	"website": "https://formbricks.com/",
	"docs": "https://formbricks.com/docs",
	"version": "v3.1.3",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/formbricks",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "secretBase",
			"label": "Secret base",
			"type": "base64",
			"bytes": 64
		},
		{
			"key": "encryptionKey",
			"label": "Encryption key",
			"type": "password",
			"length": 32
		},
		{
			"key": "cronSecret",
			"label": "Cron secret",
			"type": "base64",
			"bytes": 32
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "postgres",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "pgvector/pgvector:pg17",
			"ports": [],
			"restart": "any"
		},
		{
			"name": "formbricks",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"WEBAPP_URL": "https://${{ inputs.mainDomain }}",
				"NEXTAUTH_URL": "https://${{ inputs.mainDomain }}",
				"DATABASE_URL": "postgresql://postgres:${{ inputs.dbPassword }}@${{ services.postgres.host }}:5432/formbricks?schema=public",
				"NEXTAUTH_SECRET": "${{ inputs.secretBase }}",
				"ENCRYPTION_KEY": "${{ inputs.encryptionKey }}",
				"CRON_SECRET": "${{ inputs.cronSecret }}",
				"EMAIL_VERIFICATION_DISABLED": "1",
				"PASSWORD_RESET_DISABLED": "1",
				"S3_FORCE_PATH_STYLE": "0"
			},
			"volumes": [
				{
					"name": "files-uploads",
					"target": "/home/nextjs/apps/web/uploads"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/formbricks/formbricks:v3.1.5",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
