{
	"schema": 1,
	"id": "trmnl-larapaper",
	"name": "TRMNL LaraPaper",
	"description": "LaraPaper is a self-hosted application (BYOS) to manage TRMNL e-ink devices.",
	"category": "other",
	"tags": [
		"e-ink"
	],
	"logo": "logos/trmnl-larapaper.svg",
	"website": "https://docs.usetrmnl.com/go/diy/byos",
	"docs": "https://github.com/usetrmnl/larapaper/blob/main/README.md",
	"version": "0.45.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/trmnl-larapaper",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "trmnl-larapaper",
			"dependsOn": [],
			"env": {
				"APP_URL": "${{ inputs.mainDomain }}",
				"PHP_OPCACHE_ENABLE": "1",
				"DB_DATABASE": "database/storage/database.sqlite",
				"APP_TIMEZONE": "UTC",
				"REGISTRATION_ENABLED": "1",
				"FORCE_HTTPS": "0"
			},
			"volumes": [
				{
					"name": "trmnl-database",
					"target": "/var/www/html/database/storage"
				},
				{
					"name": "trmnl-storage",
					"target": "/var/www/html/storage/app/public/images/generated"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/usetrmnl/larapaper:0.45.0",
			"ports": [],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
