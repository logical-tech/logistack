{
	"schema": 1,
	"id": "mediafetch",
	"name": "MediaFetch",
	"description": "A tiny, self-hosted web wrapper for yt-dlp to download video and audio. Optional basic auth.",
	"category": "media",
	"tags": [
		"utilities",
		"media",
		"downloader"
	],
	"logo": "logos/mediafetch.svg",
	"website": "https://www.lukedunsmore.com/mediafetch",
	"docs": "https://docs.lukedunsmore.com/docs/self-hosted/mediafetch/",
	"version": "1.1.1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/mediafetch",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "basicAuthPassword",
			"label": "Basic auth password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "mediafetch",
			"dependsOn": [],
			"env": {
				"PORT": "3002",
				"BASIC_AUTH_USER": "admin",
				"BASIC_AUTH_PASS": "${{ inputs.basicAuthPassword }}",
				"PUBLIC_BASE_URL": "https://${{ inputs.mainDomain }}",
				"OUTPUT_DIR": "/data/downloads",
				"MAX_CONCURRENT_JOBS": "2",
				"JOB_TIMEOUT_MS": "600000",
				"VERSION_CHECK_TTL_MS": "21600000"
			},
			"volumes": [
				{
					"name": "mediafetch-data",
					"target": "/data/downloads"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lukedunsmoto/mediafetch:1.3.5",
			"ports": [
				{
					"target": 3002,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3002,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
