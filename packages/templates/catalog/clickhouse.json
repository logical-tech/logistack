{
	"schema": 1,
	"id": "clickhouse",
	"name": "ClickHouse",
	"description": "ClickHouse is a fast, open-source columnar database built for real-time analytics.",
	"category": "database",
	"tags": [
		"self-hosted",
		"open-source",
		"database",
		"olap",
		"analytics"
	],
	"logo": "logos/clickhouse.png",
	"website": "https://clickhouse.com/",
	"docs": "https://clickhouse.com/docs",
	"version": "sha256:739e099abd11",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/clickhouse",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "clickhousePassword",
			"label": "Clickhouse password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "clickhouse",
			"dependsOn": [],
			"env": {
				"CLICKHOUSE_USER": "default",
				"CLICKHOUSE_PASSWORD": "${{ inputs.clickhousePassword }}"
			},
			"volumes": [
				{
					"name": "clickhouse-data",
					"target": "/var/lib/clickhouse"
				},
				{
					"name": "clickhouse-logs",
					"target": "/var/log/clickhouse-server"
				}
			],
			"files": [],
			"kind": "application",
			"image": "clickhouse/clickhouse-server@sha256:739e099abd1157390960a59e4532d21781d8fde57e6e4151cb920ea02c30b1ce",
			"ports": [],
			"public": {
				"port": 8123,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
