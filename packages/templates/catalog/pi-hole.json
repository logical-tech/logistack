{
	"schema": 1,
	"id": "pi-hole",
	"name": "Pi Hole",
	"description": "Network-wide Ad Blocking",
	"category": "networking",
	"tags": [
		"ad-block",
		"dns",
		"sinkhole",
		"ntp",
		"dhcp"
	],
	"logo": "logos/pi-hole.svg",
	"docs": "https://pi-hole.net/",
	"version": "sha256:30f803ad5dd6",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/pi-hole.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "piholeDomain",
			"label": "Pihole domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "piholePassword",
			"label": "Pihole password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "pihole",
			"dependsOn": [],
			"env": {
				"TZ": "Europe/London",
				"FTLCONF_webserver_api_password": "${{ inputs.piholePassword }}",
				"FTLCONF_dns_listeningMode": "all"
			},
			"volumes": [
				{
					"name": "pihole-data",
					"target": "/etc/pihole"
				}
			],
			"files": [],
			"kind": "application",
			"image": "pihole/pihole@sha256:30f803ad5dd60ff96cc0a63008a2e9271af481c1b0399a182192b2e91152c1f9",
			"ports": [
				{
					"target": 53,
					"published": 53,
					"protocol": "tcp",
					"mode": "host"
				},
				{
					"target": 53,
					"published": 53,
					"protocol": "udp",
					"mode": "host"
				},
				{
					"target": 67,
					"published": 67,
					"protocol": "udp",
					"mode": "host"
				},
				{
					"target": 123,
					"published": 123,
					"protocol": "udp",
					"mode": "host"
				}
			],
			"public": {
				"port": 80,
				"domain": "piholeDomain"
			},
			"capAdd": [
				"NET_ADMIN",
				"SYS_TIME"
			]
		}
	]
}
