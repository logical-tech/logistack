{
	"schema": 1,
	"id": "wordpress",
	"name": "Wordpress",
	"description": "Wordpress is a free and open source content management system (CMS) for publishing and managing websites.",
	"category": "cms",
	"tags": [
		"cms"
	],
	"website": "https://wordpress.org/",
	"docs": "https://wordpress.org/documentation/",
	"version": "sha256:1f59452d2cee",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/wordpress",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "wordpress",
			"dependsOn": [
				"wp-db"
			],
			"env": {
				"WORDPRESS_DB_HOST": "${{ services.wp-db.host }}",
				"WORDPRESS_DB_NAME": "wordpress",
				"WORDPRESS_DB_USER": "root",
				"WORDPRESS_DB_PASSWORD": "${{ inputs.dbPassword }}",
				"WORDPRESS_DEBUG": "0",
				"WORDPRESS_CONFIG_EXTRA": "define('WP_MEMORY_LIMIT', '256M');\ndefine('DISALLOW_FILE_EDIT', true);\n"
			},
			"volumes": [
				{
					"name": "wp-app",
					"target": "/var/www/html"
				}
			],
			"files": [
				{
					"target": "/usr/local/etc/php/conf.d/uploads.ini",
					"content": "upload_max_filesize = 64M\npost_max_size = 64M\nmemory_limit = 256M\nmax_execution_time = 300\nmax_input_vars = 3000\n"
				}
			],
			"kind": "application",
			"image": "wordpress@sha256:1f59452d2ceed177ad383d17b3a6a7a5c8225d89e34adb36880af8603ac244c2",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "wp-db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.dbPassword }}",
				"MYSQL_DATABASE": "wordpress"
			},
			"volumes": [
				{
					"name": "wp-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mysql",
			"version": "8.4"
		}
	]
}
