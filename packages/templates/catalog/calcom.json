{
	"schema": 1,
	"id": "calcom",
	"name": "Calcom",
	"description": "Cal.com is a scheduling and booking tool and an alternative to Calendly. com as a Docker Compose service in a few clicks.",
	"category": "other",
	"tags": [
		"scheduling",
		"booking"
	],
	"logo": "logos/calcom.jpg",
	"website": "https://cal.com/",
	"docs": "https://cal.com/docs",
	"version": "v6.2.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/calcom",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "nextauthSecret",
			"label": "Nextauth secret",
			"type": "base64",
			"bytes": 32
		},
		{
			"key": "cronApiKey",
			"label": "Cron API key",
			"type": "secret",
			"length": 32,
			"charset": "hex"
		},
		{
			"key": "calendsoEncryptionKey",
			"label": "Calendso encryption key",
			"type": "base64",
			"bytes": 24
		},
		{
			"key": "calcomCredentialSyncSecret",
			"label": "Calcom credential sync secret",
			"type": "base64",
			"bytes": 32
		},
		{
			"key": "calcomAppCredentialEncryptionKey",
			"label": "Calcom app credential encryption key",
			"type": "base64",
			"bytes": 24
		},
		{
			"key": "calcomServiceAccountEncryptionKey",
			"label": "Calcom service account encryption key",
			"type": "base64",
			"bytes": 24
		},
		{
			"key": "calVideoRecordingTokenSecret",
			"label": "Cal video recording token secret",
			"type": "base64",
			"bytes": 32
		}
	],
	"services": [
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "calcom",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "calendso"
			},
			"volumes": [
				{
					"name": "calcom-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		},
		{
			"name": "calcom",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"DATABASE_URL": "postgresql://calcom:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/calendso",
				"DATABASE_DIRECT_URL": "postgresql://calcom:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/calendso",
				"INSIGHTS_DATABASE_URL": "",
				"NEXT_PUBLIC_WEBAPP_URL": "https://${{ inputs.mainDomain }}",
				"NEXT_PUBLIC_WEBSITE_URL": "https://${{ inputs.mainDomain }}",
				"NEXT_PUBLIC_EMBED_LIB_URL": "https://${{ inputs.mainDomain }}/embed/embed.js",
				"ALLOWED_HOSTNAMES": "\"${{ inputs.mainDomain }}\"",
				"RESERVED_SUBDOMAINS": "\"app\",\"auth\",\"docs\",\"design\",\"console\",\"go\",\"status\",\"api\",\"saml\",\"www\",\"matrix\",\"developer\",\"cal\",\"my\",\"team\",\"support\",\"security\",\"blog\",\"learn\",\"admin\"",
				"SAML_DATABASE_URL": "",
				"SAML_ADMINS": "",
				"NEXT_PUBLIC_HOSTED_CAL_FEATURES": "",
				"PGSSLMODE": "",
				"NEXTAUTH_URL": "https://${{ inputs.mainDomain }}",
				"NEXTAUTH_SECRET": "${{ inputs.nextauthSecret }}",
				"NEXTAUTH_COOKIE_DOMAIN": "",
				"CALCOM_TELEMETRY_DISABLED": "1",
				"CRON_API_KEY": "${{ inputs.cronApiKey }}",
				"CRON_ENABLE_APP_SYNC": "false",
				"CALENDSO_ENCRYPTION_KEY": "${{ inputs.calendsoEncryptionKey }}",
				"NEXT_PUBLIC_INTERCOM_APP_ID": "",
				"INTERCOM_SECRET": "",
				"INTERCOM_API_TOKEN": "",
				"NEXT_PUBLIC_POSTHOG_KEY": "",
				"NEXT_PUBLIC_POSTHOG_HOST": "",
				"NEXT_PUBLIC_ZENDESK_KEY": "",
				"NEXT_PUBLIC_HELPSCOUT_KEY": "",
				"NEXT_PUBLIC_FRESHCHAT_TOKEN": "",
				"NEXT_PUBLIC_FRESHCHAT_HOST": "",
				"DUB_API_KEY": "",
