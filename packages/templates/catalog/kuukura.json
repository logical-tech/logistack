{
	"schema": 1,
	"id": "kuukura",
	"name": "kuukura",
	"description": "kuukura is a self-hosted secrets vault for small teams: values are decrypted only on your server, reveals require a passkey, and every access is audit-logged. Requires a Google OAuth client ID and secret, set in the Environment tab before deploying.",
	"category": "security",
	"tags": [
		"security",
		"secrets",
		"self-hosted"
	],
	"logo": "logos/kuukura.svg",
	"website": "https://kuukura-main-landing.neodev-f72.workers.dev/",
	"docs": "https://github.com/victorlunam/kuukura/blob/main/docs/deploy.md",
	"version": "2026.10.13",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/kuukura",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "kuukura",
			"dependsOn": [],
			"env": {
				"VAULT_DOMAIN": "${{ inputs.mainDomain }}",
				"VAULT_STORAGE": "sqlite",
				"VAULT_SQLITE_PATH": "/data/kuukura.db",
				"VAULT_KEY_PROVIDER": "manual",
				"VAULT_MASTER_KEY_FILE": "/keys/master_key",
				"VAULT_MASTER_KEY_GENERATE": "true",
				"VAULT_OIDC_CLIENT_ID": "",
				"VAULT_OIDC_CLIENT_SECRET": "",
				"VAULT_TRUSTED_PROXIES": ""
			},
			"volumes": [
				{
					"name": "kuukura-data",
					"target": "/data"
				},
				{
					"name": "kuukura-keys",
					"target": "/keys"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/victorlunam/kuukura:2026.10.13",
			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"/ku-server",
					"healthcheck"
				]
			},
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
