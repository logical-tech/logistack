			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"-q",
					"--spider",
					"http://127.0.0.1:8000"
				]
			},
			"public": {
				"port": 8000,
				"domain": "statusnookDomain"
			}
		}
