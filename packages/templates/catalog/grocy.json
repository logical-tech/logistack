{
	"schema": 1,
	"id": "grocy",
	"name": "Grocy",
	"description": "Grocy is a web-based household management and grocery list application.",
	"category": "productivity",
	"tags": [
		"groceries",
		"household",
		"management",
		"grocery",
		"shopping"
	],
	"logo": "logos/grocy.svg",
	"docs": "https://github.com/grocy/grocy",
	"version": "4.7.1",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/grocy.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "grocyDomain",
			"label": "Grocy domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "grocy",
			"dependsOn": [],
			"env": {
				"PUID": "1000",
				"PGID": "1000",
				"TZ": "Europe/Madrid"
			},
			"volumes": [
				{
					"name": "grocy-config",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lscr.io/linuxserver/grocy:4.7.1",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:80"
				]
			},
			"public": {
				"port": 80,
				"domain": "grocyDomain"
			}
		}
	]
}
