{
	"schema": 1,
	"id": "qdrant",
	"name": "Qdrant",
	"description": "Qdrant is a vector similarity search engine that provides a production-ready service with a convenient API to store, search, and manage points (i.e. vectors) with an additional payload.",
	"category": "database",
	"tags": [
		"ai",
		"vector-database",
		"semantic-search",
		"machine-learning",
		"bm25",
		"embeddings",
		"llm",
		"vector-db",
		"database",
		"search"
	],
	"logo": "logos/qdrant.png",
	"website": "https://qdrant.tech/",
	"docs": "https://qdrant.tech/documentation/",
	"version": "sha256:9bfc89f9914f",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/qdrant.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "qdrantDomain",
			"label": "Qdrant domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "qdrantapikeyPassword",
			"label": "Qdrantapikey password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "qdrant",
			"dependsOn": [],
			"env": {
				"QDRANT__SERVICE__API_KEY": "${{ inputs.qdrantapikeyPassword }}"
			},
			"volumes": [
				{
					"name": "qdrant-storage",
					"target": "/qdrant/storage"
				}
			],
			"files": [],
			"kind": "application",
			"image": "qdrant/qdrant@sha256:9bfc89f9914fc14876a88c05270685921a55b8877b254a98bcc1cc2f0a424cd2",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"bash -c ':> /dev/tcp/127.0.0.1/6333' || exit 1"
				]
			},
			"public": {
				"port": 6333,
				"domain": "qdrantDomain"
			}
		}
	]
}
