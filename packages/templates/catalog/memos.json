	"category": "productivity",
	"tags": [
		"note-taking",
		"microblog",
		"social-network",
		"markdown",
		"productivity",
		"notes",
		"bookmarks"
	],
	"logo": "logos/memos.png",
	"website": "https://www.usememos.com/",
	"docs": "https://github.com/usememos/memos",
	"version": "sha256:087e7dc6b76b",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/memos.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
