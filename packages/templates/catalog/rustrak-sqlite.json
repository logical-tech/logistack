{
	"schema": 1,
	"id": "rustrak-sqlite",
	"name": "Rustrak (Full Stack SQLite)",
	"description": "Self-hosted error tracking compatible with Sentry SDKs. Full stack with the Rust server, web dashboard and built-in SQLite storage. No external database required.",
	"category": "monitoring",
	"tags": [
		"monitoring",
		"error-tracking",
		"sentry",
		"rust",
		"observability",
		"sqlite"
	],
	"logo": "logos/rustrak-sqlite.svg",
	"website": "https://rustrak.github.io/rustrak/",
	"docs": "https://rustrak.github.io/rustrak/getting-started/overview",
	"version": "sha256:3ad590dde4cf",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/rustrak-sqlite",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "sessionSecretKey",
			"label": "Session secret key",
			"type": "password",
			"length": 64
		},
		{
			"key": "adminEmail",
			"label": "Admin email",
			"type": "text",
			"default": "admin@example.com"
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 16
		},
		{
			"key": "apiDomain",
			"label": "API domain",
			"type": "domain",
			"role": "extra"
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "rustrak-server",
			"dependsOn": [],
			"env": {
				"HOST": "0.0.0.0",
				"PORT": "8080",
				"RUST_LOG": "info",
				"SSL_PROXY": "true",
				"SESSION_SECRET_KEY": "${{ inputs.sessionSecretKey }}",
				"CREATE_SUPERUSER": "${{ inputs.adminEmail }}:${{ inputs.adminPassword }}"
			},
			"volumes": [
				{
					"name": "rustrak-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "rustrak/rustrak-server@sha256:921e5871ff24e263a661e6dec0b0180fdbdbe02512e5f20d5a0c5ffcd19c9bbf",
			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8080,
				"domain": "apiDomain"
			},
			"restart": "any"
		},
		{
			"name": "rustrak-ui",
			"dependsOn": [
				"rustrak-server"
			],
			"env": {
				"RUSTRAK_API_URL": "https://${{ inputs.apiDomain }}",
				"HOSTNAME": "0.0.0.0"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "rustrak/rustrak-ui@sha256:3ad590dde4cf4361da08e91ed897184f7d699284e6dc02202e717378efefc230",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
