{
	"schema": 1,
	"id": "classicpress-with-mariadb",
	"name": "Classicpress With Mariadb",
	"description": "A lightweight, stable, instantly familiar free open-source content management system, based on WordPress without the block editor (Gutenberg).",
	"category": "cms",
	"tags": [
		"cms",
		"blog",
		"content",
		"management"
	],
	"logo": "logos/classicpress-with-mariadb.svg",
	"docs": "https://www.classicpress.net/",
	"version": "sha256:4f171f959f80",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/classicpress-with-mariadb.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "classicpressDomain",
			"label": "Classicpress domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "classicpressUser",
			"label": "Classicpress user",
			"type": "username"
		},
		{
			"key": "classicpressPassword",
			"label": "Classicpress password",
			"type": "password",
			"length": 32
		},
		{
			"key": "rootPassword",
			"label": "Root password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "classicpress",
			"dependsOn": [
				"mariadb"
			],
			"env": {
				"CLASSICPRESS_DB_HOST": "${{ services.mariadb.host }}",
				"CLASSICPRESS_DB_USER": "${{ inputs.classicpressUser }}",
				"CLASSICPRESS_DB_PASSWORD": "${{ inputs.classicpressPassword }}",
				"CLASSICPRESS_DB_NAME": "classicpress"
			},
			"volumes": [
				{
					"name": "classicpress-files",
					"target": "/var/www/html"
				}
			],
			"files": [],
			"kind": "application",
			"image": "classicpress/classicpress@sha256:4f171f959f80420fd6ef1c46ef4031dcc4f87ed1bf1c97c60d13c17bacbaaaec",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1"
				]
			},
			"public": {
				"port": 80,
				"domain": "classicpressDomain"
			}
		},
		{
			"name": "mariadb",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.rootPassword }}",
				"MYSQL_DATABASE": "classicpress",
				"MYSQL_USER": "${{ inputs.classicpressUser }}",
				"MYSQL_PASSWORD": "${{ inputs.classicpressPassword }}"
			},
			"volumes": [
				{
					"name": "mariadb-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mariadb:11",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"healthcheck.sh",
					"--connect",
					"--innodb_initialized"
				]
			}
		}
	]
}
