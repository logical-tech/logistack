{
	"schema": 1,
	"id": "jitsi",
	"name": "Jitsi",
	"description": "Self-hosted Jitsi Meet — open-source video conferencing platform",
	"category": "productivity",
	"tags": [
		"jitsi",
		"video",
		"conference",
		"webrtc",
		"meeting",
		"self-hosted",
		"video-conferencing",
		"meetings"
	],
	"logo": "logos/jitsi.svg",
	"website": "https://jitsi.org/jitsi-meet/",
	"docs": "https://jitsi.github.io/handbook/docs/devops-guide/devops-guide-docker/",
	"version": "stable-10888",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/jitsi.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "jitsiDomain",
			"label": "Jitsi domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "jicofoPassword",
			"label": "Jicofo password",
			"type": "password",
			"length": 32
		},
		{
			"key": "jvbPassword",
			"label": "Jvb password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "jitsi-web",
			"dependsOn": [
				"prosody",
				"jicofo",
				"jvb"
			],
			"env": {
				"PUBLIC_URL": "https://${{ inputs.jitsiDomain }}",
				"ENABLE_AUTH": "0",
				"ENABLE_GUESTS": "1",
				"ENABLE_LETSENCRYPT": "0",
				"ENABLE_HTTP_REDIRECT": "0",
				"DISABLE_HTTPS": "1",
				"XMPP_DOMAIN": "meet.jitsi",
				"XMPP_AUTH_DOMAIN": "auth.meet.jitsi",
				"XMPP_GUEST_DOMAIN": "guest.meet.jitsi",
				"XMPP_MUC_DOMAIN": "conference.meet.jitsi",
				"XMPP_INTERNAL_MUC_DOMAIN": "internal.auth.meet.jitsi",
				"XMPP_BOSH_URL_BASE": "http://${{ services.prosody.host }}:5280",
				"JVB_BREWERY_MUC": "jvbbrewery",
				"JICOFO_COMPONENT_SECRET": "${{ inputs.jicofoPassword }}",
				"JICOFO_AUTH_PASSWORD": "${{ inputs.jicofoPassword }}",
				"JVB_AUTH_PASSWORD": "${{ inputs.jvbPassword }}",
				"TZ": "UTC"
			},
			"volumes": [
				{
					"name": "jitsi-web",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "jitsi/web:stable-10888",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost"
				]
			},
			"public": {
				"port": 80,
				"domain": "jitsiDomain"
			},
			"restart": "any"
		},
		{
			"name": "prosody",
			"dependsOn": [],
			"env": {
				"AUTH_TYPE": "internal",
				"ENABLE_AUTH": "0",
				"ENABLE_GUESTS": "1",
				"XMPP_DOMAIN": "meet.jitsi",
				"XMPP_AUTH_DOMAIN": "auth.meet.jitsi",
				"XMPP_GUEST_DOMAIN": "guest.meet.jitsi",
				"XMPP_MUC_DOMAIN": "conference.meet.jitsi",
				"XMPP_INTERNAL_MUC_DOMAIN": "internal.auth.meet.jitsi",
				"JICOFO_COMPONENT_SECRET": "${{ inputs.jicofoPassword }}",
				"JICOFO_AUTH_PASSWORD": "${{ inputs.jicofoPassword }}",
				"JVB_AUTH_PASSWORD": "${{ inputs.jvbPassword }}",
				"PUBLIC_URL": "https://${{ inputs.jitsiDomain }}",
				"TZ": "UTC",
				"LOG_LEVEL": "info"
			},
			"volumes": [
				{
					"name": "jitsi-prosody",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "jitsi/prosody:stable-10888",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:5280/http-bind"
				]
			},
			"restart": "any"
		},
		{
			"name": "jicofo",
			"dependsOn": [
				"prosody"
			],
			"env": {
				"AUTH_TYPE": "internal",
				"ENABLE_AUTH": "0",
				"XMPP_DOMAIN": "meet.jitsi",
				"XMPP_AUTH_DOMAIN": "auth.meet.jitsi",
				"XMPP_INTERNAL_MUC_DOMAIN": "internal.auth.meet.jitsi",
				"XMPP_MUC_DOMAIN": "conference.meet.jitsi",
				"XMPP_SERVER": "${{ services.prosody.host }}",
				"JICOFO_COMPONENT_SECRET": "${{ inputs.jicofoPassword }}",
				"JICOFO_AUTH_PASSWORD": "${{ inputs.jicofoPassword }}",
				"JVB_BREWERY_MUC": "jvbbrewery",
				"JICOFO_ENABLE_HEALTH_CHECKS": "1",
				"TZ": "UTC"
			},
			"volumes": [
				{
					"name": "jitsi-jicofo",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "jitsi/jicofo:stable-10888",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:8888/about/health"
				]
			},
			"restart": "any"
		},
		{
			"name": "jvb",
			"dependsOn": [
				"prosody"
			],
			"env": {
				"XMPP_SERVER": "${{ services.prosody.host }}",
				"XMPP_DOMAIN": "meet.jitsi",
				"XMPP_AUTH_DOMAIN": "auth.meet.jitsi",
				"XMPP_INTERNAL_MUC_DOMAIN": "internal.auth.meet.jitsi",
				"XMPP_MUC_DOMAIN": "conference.meet.jitsi",
				"JVB_AUTH_USER": "jvb",
				"JVB_AUTH_PASSWORD": "${{ inputs.jvbPassword }}",
				"JVB_BREWERY_MUC": "jvbbrewery",
				"JVB_PORT": "10000",
				"JVB_ADVERTISE_IPS": "",
				"JVB_STUN_SERVERS": "stun.l.google.com:19302",
				"PUBLIC_URL": "https://${{ inputs.jitsiDomain }}",
				"TZ": "UTC"
			},
			"volumes": [
				{
					"name": "jitsi-jvb",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "jitsi/jvb:stable-10888",
			"ports": [
				{
					"target": 10000,
					"published": 10000,
					"protocol": "udp",
					"mode": "host"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:8080/about/health"
				]
			},
			"restart": "any"
		}
	]
}
