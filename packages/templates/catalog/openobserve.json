{
	"schema": 1,
	"id": "openobserve",
	"name": "Openobserve",
	"description": "Cloud-native observability platform for logs, metrics, traces, RUM, errors and session replays — a 140x cheaper alternative to Elasticsearch, Splunk and Datadog.",
	"category": "monitoring",
	"tags": [
		"logs",
		"metrics",
		"traces",
		"observability",
		"monitoring",
		"opentelemetry",
		"otel",
		"elasticsearch",
		"splunk",
		"datadog",
		"apm"
	],
	"logo": "logos/openobserve.svg",
	"website": "https://openobserve.ai/",
	"docs": "https://openobserve.ai/docs/",
	"version": "v0.90.0",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/openobserve.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "openobserveDomain",
			"label": "Openobserve domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "openobservePassword",
			"label": "Openobserve password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "openobserve",
			"dependsOn": [],
			"env": {
				"ZO_DATA_DIR": "/data",
				"ZO_ROOT_USER_EMAIL": "root@example.com",
				"ZO_ROOT_USER_PASSWORD": "${{ inputs.openobservePassword }}",
				"ZO_TELEMETRY": "false",
				"ZO_COOKIE_SECURE_ONLY": "true"
			},
			"volumes": [
				{
					"name": "openobserve-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "public.ecr.aws/zinclabs/openobserve:v0.90.0",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"/openobserve",
					"node",
					"status"
				]
			},
			"public": {
				"port": 5080,
				"domain": "openobserveDomain"
			}
		}
	]
}
