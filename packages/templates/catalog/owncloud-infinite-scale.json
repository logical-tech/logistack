{
	"schema": 1,
	"id": "owncloud-infinite-scale",
	"name": "ownCloud Infinite Scale",
	"description": "ownCloud Infinite Scale is a modern file sync and share platform with WebDAV and ownCloud client support.",
	"category": "storage",
	"tags": [
		"storage",
		"files",
		"sync",
		"webdav",
		"collaboration"
	],
	"logo": "logos/owncloud-infinite-scale.svg",
	"website": "https://owncloud.com/infinite-scale/",
	"docs": "https://doc.owncloud.com/ocis/latest/",
	"version": "8.0.3",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/owncloud-infinite-scale",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "gateway",
			"dependsOn": [
				"owncloud-infinite-scale"
			],
			"env": {},
			"volumes": [],
			"files": [
				{
					"target": "/etc/nginx/conf.d/default.conf",
					"content": "map $http_upgrade $connection_upgrade {\n  default upgrade;\n  \"\" close;\n}\n\nserver {\n  listen 8080;\n  client_max_body_size 0;\n  proxy_request_buffering off;\n\n  location / {\n    proxy_pass http://owncloud-infinite-scale:9200;\n    proxy_http_version 1.1;\n    proxy_set_header Host $host;\n    proxy_set_header X-Real-IP $remote_addr;\n    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n    proxy_set_header X-Forwarded-Host $host;\n    proxy_set_header X-Forwarded-Proto https;\n    proxy_set_header Upgrade $http_upgrade;\n    proxy_set_header Connection $connection_upgrade;\n    proxy_read_timeout 3600s;\n    proxy_send_timeout 3600s;\n  }\n}\n"
				}
			],
			"kind": "application",
			"image": "nginx:1.27-alpine",
			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "owncloud-infinite-scale",
			"dependsOn": [],
			"env": {
				"OCIS_URL": "https://${{ inputs.mainDomain }}",
				"OCIS_LOG_LEVEL": "info",
				"OCIS_INSECURE": "true",
				"PROXY_TLS": "false",
				"PROXY_HTTP_ADDR": "0.0.0.0:9200",
				"IDM_ADMIN_PASSWORD": "${{ inputs.adminPassword }}",
				"SETTINGS_GRPC_ADDR": "0.0.0.0:9191",
				"GATEWAY_GRPC_ADDR": "0.0.0.0:9142",
				"STORAGE_USERS_DATA_GATEWAY_URL": "http://${{ services.owncloud-infinite-scale.host }}:9200/data",
				"THUMBNAILS_FILESYSTEMSTORAGE_ROOT": "/var/lib/ocis-thumbnails"
			},
			"volumes": [
				{
					"name": "owncloud-infinite-scale-config",
					"target": "/etc/ocis"
				},
				{
					"name": "owncloud-infinite-scale-data",
					"target": "/var/lib/ocis"
				},
				{
					"name": "owncloud-infinite-scale-thumbnails",
					"target": "/var/lib/ocis-thumbnails"
				}
			],
			"files": [],
			"kind": "application",
			"image": "owncloud/ocis:8.0.3",
			"command": [
				"-c",
				"ocis init --insecure yes || true; ocis server"
			],
			"entrypoint": [
				"/bin/sh"
			],
			"ports": [
				{
					"target": 9200,
					"protocol": "tcp"
				}
			],
			"restart": "any"
		}
	]
}
