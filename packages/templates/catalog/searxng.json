{
	"schema": 1,
	"id": "searxng",
	"name": "Searxng",
	"description": "SearXNG is a free internet metasearch engine which aggregates results from more than 70 search services.",
	"category": "productivity",
	"tags": [
		"search",
		"google",
		"engine",
		"images",
		"documents",
		"rss",
		"proxy",
		"news",
		"web",
		"api",
		"search-engine",
		"metasearch",
		"privacy",
		"self-hosted",
		"aggregator"
	],
	"logo": "logos/searxng.svg",
	"website": "https://searxng.github.io/",
	"docs": "https://docs.searxng.org/",
	"version": "sha256:892ed5710603",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/searxng.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "searxngDomain",
			"label": "Searxng domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "searxngsecretPassword",
			"label": "Searxngsecret password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "searxng",
			"dependsOn": [
				"redis"
			],
			"env": {
				"INSTANCE_NAME": "SearXNG",
				"BASE_URL": "https://${{ inputs.searxngDomain }}",
				"SEARXNG_URL": "https://${{ inputs.searxngDomain }}",
				"SEARXNG_BIND_ADDRESS": "0.0.0.0",
				"SEARXNG_SECRET": "${{ inputs.searxngsecretPassword }}",
				"SEARXNG_REDIS_URL": "redis://${{ services.redis.host }}:6379/0"
			},
			"volumes": [],
			"files": [
				{
					"target": "/etc/searxng/settings.yml",
					"content": "# see https://docs.searxng.org/admin/settings/settings.html#settings-use-default-settings\nuse_default_settings: true\nserver:\n  limiter: false\n  image_proxy: true\nsearch:\n  formats:\n    - html\n    - csv\n    - json\n    - rss\nui:\n  static_use_hash: true\n"
				},
				{
					"target": "/etc/searxng/limiter.toml",
					"content": "# This configuration file updates the default configuration file\n# See https://github.com/searxng/searxng/blob/master/searx/botdetection/limiter.toml\n\n[botdetection.ip_limit]\n# activate link_token method in the ip_limit method\nlink_token = true\n"
				}
			],
			"kind": "application",
			"image": "searxng/searxng@sha256:892ed5710603e38f9dc201e6a0b2f3f14dbdb8108edcadac30e55b165c979fb7",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"-q",
					"--spider",
					"http://127.0.0.1:8080/healthz"
				]
			},
			"public": {
				"port": 8080,
				"domain": "searxngDomain"
			}
		},
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "redis-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redis:7",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"redis-cli",
					"ping"
				]
			},
			"restart": "any"
		}
	]
}
