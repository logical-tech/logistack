{
	"schema": 1,
	"id": "hoppscotch",
	"name": "Hoppscotch",
	"description": "The Open Source API Development Platform",
	"category": "devtools",
	"tags": [
		"api",
		"development",
		"platform",
		"testing",
		"postman-alternative",
		"graphql"
	],
	"website": "https://hoppscotch.io/",
	"docs": "https://docs.hoppscotch.io/",
	"version": "2026.2.1",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/hoppscotch.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "hoppscotchDomain",
			"label": "Hoppscotch domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "postgresDb",
			"label": "Postgres DB",
			"type": "text",
			"default": ""
		},
		{
			"key": "dataencryptionkeySecret",
			"label": "Dataencryptionkey secret",
			"type": "secret",
			"length": 32,
			"charset": "alnum"
		}
	],
	"services": [
		{
			"name": "backend",
			"dependsOn": [
				"db-migration"
			],
			"env": {
				"VITE_ALLOWED_AUTH_PROVIDERS": "GOOGLE,GITHUB,MICROSOFT,EMAIL",
				"DATABASE_URL": "postgresql://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.hoppscotch-db.host }}:5432/${{ inputs.postgresDb }}",
				"DATA_ENCRYPTION_KEY": "${{ inputs.dataencryptionkeySecret }}",
				"WHITELISTED_ORIGINS": "https://${{ inputs.hoppscotchDomain }}/backend,https://${{ inputs.hoppscotchDomain }},https://${{ inputs.hoppscotchDomain }}/admin",
				"MAILER_USE_CUSTOM_CONFIGS": "true",
				"VITE_BASE_URL": "https://${{ inputs.hoppscotchDomain }}",
				"VITE_SHORTCODE_BASE_URL": "https://${{ inputs.hoppscotchDomain }}",
				"VITE_ADMIN_URL": "https://${{ inputs.hoppscotchDomain }}/admin",
				"VITE_BACKEND_GQL_URL": "https://${{ inputs.hoppscotchDomain }}/backend/graphql",
				"VITE_BACKEND_WS_URL": "wss://${{ inputs.hoppscotchDomain }}/backend/graphql",
				"VITE_BACKEND_API_URL": "https://${{ inputs.hoppscotchDomain }}/backend/v1",
				"VITE_APP_TOS_LINK": "https://docs.hoppscotch.io/support/terms",
				"VITE_APP_PRIVACY_POLICY_LINK": "https://docs.hoppscotch.io/support/privacy",
				"ENABLE_SUBPATH_BASED_ACCESS": "true"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "hoppscotch/hoppscotch:2026.2.1",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget -qO- http://127.0.0.1:80/"
				]
			},
			"public": {
				"port": 80,
				"domain": "hoppscotchDomain"
			}
		},
		{
			"name": "hoppscotch-db",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "hoppscotch"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "15"
		},
		{
			"name": "db-migration",
			"dependsOn": [
				"hoppscotch-db"
			],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "hoppscotch",
				"DATABASE_URL": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.hoppscotch-db.host }}:5432/hoppscotch"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "hoppscotch/hoppscotch:2026.2.1",
			"command": [
				"pnpx",
				"prisma",
				"migrate",
				"deploy"
			],
			"ports": [],
			"restart": "on-failure"
		}
	]
}
