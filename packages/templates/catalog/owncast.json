			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				},
				{
					"target": 1935,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
