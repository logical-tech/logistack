	"category": "media",
	"tags": [
		"streaming",
		"live-video",
		"chat",
		"broadcasting",
		"self-hosted",
		"rtmp"
	],
	"logo": "logos/owncast.png",
	"website": "https://owncast.online/",
	"docs": "https://owncast.online/docs/",
	"version": "sha256:39224bb144c1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/owncast",
		"license": "MIT"
	},
	"inputs": [
