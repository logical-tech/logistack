{
	"schema": 1,
	"id": "dolibarr",
	"name": "Dolibarr",
	"description": "Dolibarr ERP & CRM is a modern software package that helps manage your organization's activities (contacts, quotes, invoices, orders, stocks, agenda, human resources, ecm, manufacturing).",
	"category": "productivity",
	"tags": [
		"erp",
		"crm",
		"business",
		"management",
		"invoicing"
	],
	"logo": "logos/dolibarr.svg",
	"website": "https://www.dolibarr.org/",
	"docs": "https://wiki.dolibarr.org/",
	"version": "21.0.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/dolibarr",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		},
		{
			"key": "dbRootPassword",
			"label": "DB root password",
			"type": "password",
			"length": 32
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "dolibarr",
			"dependsOn": [
				"db"
			],
			"env": {
				"DOLI_DB_HOST": "${{ services.db.host }}",
				"DOLI_DB_NAME": "dolibarr",
				"DOLI_DB_USER": "dolibarr",
				"DOLI_DB_PASSWORD": "${{ inputs.dbPassword }}",
				"DOLI_URL_ROOT": "${{ inputs.mainDomain }}",
				"DOLI_ADMIN_LOGIN": "admin",
				"DOLI_ADMIN_PASSWORD": "${{ inputs.adminPassword }}"
			},
			"volumes": [
				{
					"name": "dolibarr-documents",
					"target": "/var/www/documents"
				},
				{
					"name": "dolibarr-html",
					"target": "/var/www/html"
				}
			],
			"files": [],
			"kind": "application",
			"image": "dolibarr/dolibarr:21.0.0",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.dbRootPassword }}",
				"MYSQL_DATABASE": "dolibarr",
				"MYSQL_USER": "dolibarr",
				"MYSQL_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "db-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mariadb:10.11",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"healthcheck.sh --connect --innodb_initialized"
				]
			},
			"restart": "any"
		}
	]
}
