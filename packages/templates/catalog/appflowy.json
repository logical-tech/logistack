{
	"schema": 1,
	"id": "appflowy",
	"name": "Appflowy",
	"description": "AppFlowy is the AI collaborative workspace where you achieve more without losing control of your data.",
	"category": "productivity",
	"tags": [
		"appflowy",
		"notion",
		"open-source",
		"productivity",
		"notes",
		"ai",
		"self-hosted"
	],
	"logo": "logos/appflowy.svg",
	"docs": "https://docs.appflowy.io/docs/documentation/appflowy-cloud",
	"version": "1.29.2",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/appflowy.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "adminDomain",
			"label": "Admin domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "appflowywebDomain",
			"label": "Appflowyweb domain",
			"type": "domain",
			"role": "extra"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "jwtPassword",
			"label": "JWT password",
			"type": "password",
			"length": 32
		},
		{
			"key": "minioUser",
			"label": "Minio user",
			"type": "username"
		},
		{
			"key": "minioPassword",
			"label": "Minio password",
			"type": "password",
			"length": 32
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 32
		},
		{
			"key": "gotrueSmtpHost",
			"label": "Gotrue SMTP host",
			"type": "text",
			"default": ""
		},
		{
			"key": "gotrueSmtpUser",
			"label": "Gotrue SMTP user",
			"type": "text",
			"default": ""
		},
		{
			"key": "gotrueSmtpPass",
			"label": "Gotrue SMTP pass",
			"type": "text",
			"default": ""
		},
		{
			"key": "gotrueSmtpAdminEmail",
			"label": "Gotrue SMTP admin email",
			"type": "text",
			"default": ""
		},
		{
			"key": "azureOpenaiApiKey",
			"label": "Azure openai API key",
			"type": "text",
			"default": ""
		},
		{
			"key": "azureOpenaiEndpoint",
			"label": "Azure openai endpoint",
			"type": "text",
			"default": ""
		},
		{
			"key": "azureOpenaiApiVersion",
			"label": "Azure openai API version",
			"type": "text",
			"default": ""
		}
	],
	"services": [
		{
			"name": "nginx",
			"dependsOn": [
				"appflowy-cloud",
				"gotrue",
				"admin-frontend"
			],
			"env": {},
			"volumes": [],
			"files": [
				{
					"target": "/etc/nginx/nginx.conf",
					"content": "# Please do not directly edit this file.\n\nerror_log  /var/log/nginx/error.log notice;\npid        /var/run/nginx.pid;\n\n\nevents {\n    worker_connections  1024;\n}\n\n\nhttp {\n    resolver 127.0.0.11 valid=10s;\n    map $http_upgrade $connection_upgrade {\n        default upgrade;\n        '' close;\n    }\n\n    server {\n        listen 80;\n        client_max_body_size 10M;\n        underscores_in_headers on;\n\n        # Backend services\n        set $appflowy_cloud_backend \"http://appflowy_cloud:8000\";\n        set $gotrue_backend \"http://gotrue:9999\";\n        set $admin_frontend_backend \"http://admin_frontend:3000\";\n        # GoTrue Authentication Service\n        location /gotrue/ {\n            proxy_pass $gotrue_backend;\n\n            rewrite ^/gotrue(/.*)$ $1 break;\n            \n            # Allow headers like redirect_to to be handed over to the gotrue\n            # for correct redirecting\n            proxy_set_header Host $http_host;\n            proxy_pass_request_headers on;\n        }\n\n        # WebSocket endpoint - handle both /ws and /ws/v2\n        location /ws {\n            proxy_pass $appflowy_cloud_backend;\n\n            proxy_http_version 1.1;\n            proxy_set_header Upgrade $http_upgrade;\n            proxy_set_header Connection \"Upgrade\";\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n            proxy_read_timeout 86400s;\n        }\n\n        # API endpoints\n        location /api {\n            proxy_pass $appflowy_cloud_backend;\n            proxy_set_header X-Request-Id $request_id;\n            proxy_set_header Host $http_host;\n\n            # Special handling for publish endpoint\n            location ~* ^/api/workspace/([a-zA-Z0-9_-]+)/publish$ {\n                proxy_pass $appflowy_cloud_backend;\n                proxy_request_buffering off;\n                client_max_body_size 256M;\n            }\n\n            # Chat endpoint (streaming)\n            location /api/chat {\n                proxy_pass $appflowy_cloud_backend;\n\n                proxy_http_version 1.1;\n                proxy_set_header Connection \"\";\n                chunked_transfer_encoding on;\n                proxy_buffering off;\n                proxy_cache off;\n\n                proxy_read_timeout 600s;\n                proxy_connect_timeout 600s;\n                proxy_send_timeout 600s;\n            }\n\n            # Import endpoint\n            location /api/import {\n                proxy_pass $appflowy_cloud_backend;\n\n                proxy_set_header X-Request-Id $request_id;\n                proxy_set_header Host $http_host;\n\n                proxy_read_timeout 600s;\n                proxy_connect_timeout 600s;\n                proxy_send_timeout 600s;\n\n                proxy_request_buffering off;\n                proxy_buffering off;\n                proxy_cache off;\n                client_max_body_size 2G;\n            }\n        }\n\n        # Admin Frontend\n        # Optional Module, comment this section if you did not deploy admin_frontend in docker-compose.yml\n        location /console {\n            proxy_pass $admin_frontend_backend;\n\n            proxy_set_header X-Scheme $scheme;\n            proxy_set_header Host $host;\n            proxy_set_header X-Real-IP $remote_addr;\n            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n            proxy_set_header X-Forwarded-Proto $scheme;\n\n            proxy_http_version 1.1;\n            proxy_set_header Connection \"\";\n\n            proxy_buffering off;\n            proxy_cache off;\n\n            proxy_read_timeout 60s;\n            proxy_connect_timeout 60s;\n            proxy_send_timeout 60s;\n        }\n\n        # Redirect root path to /console\n        location = / {\n            return 301 /console;\n        }\n\n        # Health check endpoint\n        location /health {\n            access_log off;\n            return 200 \"healthy\\n\";\n            add_header Content-Type text/plain;\n        }\n    }\n}\n"
				}
			],
			"kind": "application",
			"image": "nginx:1.29.2",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost/health"
				]
			},
			"public": {
				"port": 80,
				"domain": "adminDomain"
			}
		},
		{
			"name": "appflowy-web",
			"dependsOn": [
				"appflowy-cloud"
			],
			"env": {
				"APPFLOWY_BASE_URL": "https://${{ inputs.adminDomain }}",
				"APPFLOWY_GOTRUE_BASE_URL": "https://${{ inputs.adminDomain }}/gotrue",
				"APPFLOWY_WS_BASE_URL": "https://${{ inputs.adminDomain }}/ws/v2"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/appflowy_web:0.9.132",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "appflowywebDomain"
			}
		},
		{
			"name": "appflowy-cloud",
			"dependsOn": [
				"gotrue",
				"postgres",
				"redis"
			],
			"env": {
				"RUST_LOG": "info",
				"APPFLOWY_BASE_URL": "https://${{ inputs.adminDomain }}",
				"APPFLOWY_ENVIRONMENT": "production",
				"APPFLOWY_DATABASE_URL": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/appflowy",
				"APPFLOWY_REDIS_URI": "redis://${{ services.redis.host }}:6379",
				"APPFLOWY_GOTRUE_JWT_SECRET": "${{ inputs.jwtPassword }}",
				"APPFLOWY_GOTRUE_BASE_URL": "http://${{ services.gotrue.host }}:9999",
				"APPFLOWY_S3_CREATE_BUCKET": "true",
				"APPFLOWY_S3_USE_MINIO": "true",
				"APPFLOWY_S3_MINIO_URL": "http://${{ services.minio.host }}:9000",
				"APPFLOWY_S3_ACCESS_KEY": "${{ inputs.minioUser }}",
				"APPFLOWY_S3_SECRET_KEY": "${{ inputs.minioPassword }}",
				"APPFLOWY_S3_BUCKET": "appflowy",
				"APPFLOWY_S3_REGION": "us-east-1",
				"APPFLOWY_MAILER_SMTP_HOST": "smtp.gmail.com",
				"APPFLOWY_MAILER_SMTP_PORT": "587",
				"APPFLOWY_MAILER_SMTP_USERNAME": "notify@appflowy.io",
				"APPFLOWY_MAILER_SMTP_EMAIL": "notify@appflowy.io",
				"APPFLOWY_MAILER_SMTP_PASSWORD": "email_sender_password",
				"APPFLOWY_MAILER_SMTP_TLS_KIND": "none",
				"APPFLOWY_ACCESS_CONTROL": "true",
				"APPFLOWY_DATABASE_MAX_CONNECTIONS": "40",
				"AI_SERVER_HOST": "${{ services.ai.host }}",
				"AI_SERVER_PORT": "5001",
				"AI_OPENAI_API_KEY": "",
				"APPFLOWY_WEB_URL": "https://${{ inputs.appflowywebDomain }}"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/appflowy_cloud:0.9.149",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"curl --fail http://127.0.0.1:8000/api/health || exit 1"
				]
			}
		},
		{
			"name": "gotrue",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"GOTRUE_API_HOST": "0.0.0.0",
				"GOTRUE_API_PORT": "9999",
				"PORT": "9999",
				"GOTRUE_ADMIN_EMAIL": "admin@example.com",
				"GOTRUE_ADMIN_PASSWORD": "${{ inputs.adminPassword }}",
				"GOTRUE_DISABLE_SIGNUP": "false",
				"GOTRUE_SITE_URL": "appflowy-flutter://",
				"GOTRUE_URI_ALLOW_LIST": "**",
				"GOTRUE_JWT_SECRET": "${{ inputs.jwtPassword }}",
				"GOTRUE_JWT_EXP": "7200",
				"GOTRUE_DB_DRIVER": "postgres",
				"API_EXTERNAL_URL": "https://${{ inputs.adminDomain }}/gotrue",
				"DATABASE_URL": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/appflowy?search_path=auth",
				"GOTRUE_SMTP_HOST": "${{ inputs.gotrueSmtpHost }}",
				"GOTRUE_SMTP_PORT": "587",
				"GOTRUE_SMTP_USER": "${{ inputs.gotrueSmtpUser }}",
				"GOTRUE_SMTP_PASS": "${{ inputs.gotrueSmtpPass }}",
				"GOTRUE_MAILER_URLPATHS_CONFIRMATION": "/verify",
				"GOTRUE_MAILER_URLPATHS_INVITE": "/verify",
				"GOTRUE_MAILER_URLPATHS_RECOVERY": "/verify",
				"GOTRUE_MAILER_URLPATHS_EMAIL_CHANGE": "/verify",
				"GOTRUE_SMTP_ADMIN_EMAIL": "${{ inputs.gotrueSmtpAdminEmail }}",
				"GOTRUE_SMTP_MAX_FREQUENCY": "1ns",
				"GOTRUE_RATE_LIMIT_EMAIL_SENT": "100",
				"GOTRUE_MAILER_AUTOCONFIRM": "true"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/gotrue:0.9.149",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"curl --fail http://127.0.0.1:9999/health || exit 1"
				]
			}
		},
		{
			"name": "admin-frontend",
			"dependsOn": [
				"gotrue",
				"appflowy-cloud"
			],
			"env": {
				"APPFLOWY_GOTRUE_BASE_URL": "https://${{ inputs.adminDomain }}/gotrue",
				"APPFLOWY_BASE_URL": "https://${{ inputs.adminDomain }}"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/admin_frontend:0.9.149",
			"ports": []
		},
		{
			"name": "ai",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"OPENAI_API_KEY": "",
				"AI_SERVER_PORT": "5001",
				"DEFAULT_AI_MODEL": "gpt-4.1-mini",
				"DEFAULT_AI_COMPLETION_MODEL": "gpt-4.1-mini",
				"AI_APPFLOWY_HOST": "https://${{ inputs.appflowywebDomain }}",
				"APPFLOWY_GOTRUE_JWT_SECRET": "${{ inputs.jwtPassword }}",
				"AZURE_OPENAI_API_KEY": "${{ inputs.azureOpenaiApiKey }}",
				"AZURE_OPENAI_ENDPOINT": "${{ inputs.azureOpenaiEndpoint }}",
				"AZURE_OPENAI_API_VERSION": "${{ inputs.azureOpenaiApiVersion }}",
				"APPFLOWY_S3_ACCESS_KEY": "${{ inputs.minioUser }}",
				"APPFLOWY_S3_SECRET_KEY": "${{ inputs.minioPassword }}",
				"APPFLOWY_S3_BUCKET": "appflowy",
				"APPFLOWY_S3_REGION": "us-east-1",
				"AI_DATABASE_URL": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/appflowy",
				"AI_REDIS_URL": "redis://${{ services.redis.host }}:6379",
				"AI_USE_MINIO": "true",
				"AI_MINIO_URL": "http://${{ services.minio.host }}:9000"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/appflowy_ai:0.9.149",
			"ports": []
		},
		{
			"name": "appflowy-worker",
			"dependsOn": [
				"postgres",
				"redis"
			],
			"env": {
				"RUST_LOG": "info",
				"APPFLOWY_ENVIRONMENT": "production",
				"APPFLOWY_WORKER_ENVIRONMENT": "production",
				"APPFLOWY_WORKER_REDIS_URL": "redis://${{ services.redis.host }}:6379",
				"APPFLOWY_WORKER_DATABASE_URL": "postgres://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/appflowy",
				"APPFLOWY_WORKER_DATABASE_NAME": "appflowy",
				"APPFLOWY_WORKER_IMPORT_TICK_INTERVAL": "30",
				"APPFLOWY_S3_USE_MINIO": "true",
				"APPFLOWY_S3_MINIO_URL": "http://${{ services.minio.host }}:9000",
				"APPFLOWY_S3_ACCESS_KEY": "${{ inputs.minioUser }}",
				"APPFLOWY_S3_SECRET_KEY": "${{ inputs.minioPassword }}",
				"APPFLOWY_S3_BUCKET": "appflowy",
				"APPFLOWY_S3_REGION": "us-east-1",
				"APPFLOWY_MAILER_SMTP_HOST": "smtp.gmail.com",
				"APPFLOWY_MAILER_SMTP_PORT": "587",
				"APPFLOWY_MAILER_SMTP_USERNAME": "notify@appflowy.io",
				"APPFLOWY_MAILER_SMTP_EMAIL": "notify@appflowy.io",
				"APPFLOWY_MAILER_SMTP_PASSWORD": "email_sender_password",
				"APPFLOWY_MAILER_SMTP_TLS_KIND": "none"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "appflowyinc/appflowy_worker:0.9.149",
			"ports": []
		},
		{
			"name": "minio",
			"dependsOn": [],
			"env": {
				"MINIO_ROOT_USER": "${{ inputs.minioUser }}",
				"MINIO_ROOT_PASSWORD": "${{ inputs.minioPassword }}"
			},
			"volumes": [
				{
					"name": "minio-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "pgsty/silo:RELEASE.2026-10-15T00-00-00Z",
			"command": [
				"server",
				"/data",
				"--console-address",
				":9001"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"mc",
					"ready",
					"local"
				]
			}
		},
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_DB": "appflowy",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_HOST": "${{ services.postgres.host }}"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "pgvector/pgvector:pg16",
			"ports": []
		},
		{
			"name": "redis",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "redis-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "redis:8.2.2-alpine3.22",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"redis-cli -h localhost -p 6379 ping"
				]
			}
		}
	]
}
