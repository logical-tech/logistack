{
	"schema": 1,
	"id": "blogfactory",
	"name": "BlogFactory",
	"description": "Self-hosted control plane for AI-assisted content operations and human-approved CMS draft delivery.",
	"category": "ai",
	"tags": [
		"ai",
		"automation",
		"content-management"
	],
	"logo": "logos/blogfactory.svg",
	"website": "https://blogfactory.io/",
	"docs": "https://github.com/BlogFactoryHQ/blogfactory/blob/main/docs/self-hosting.md",
	"version": "v0.1.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/blogfactory",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 48
		},
		{
			"key": "minioRootPassword",
			"label": "Minio root password",
			"type": "password",
			"length": 48
		},
		{
			"key": "jwtSecret",
			"label": "JWT secret",
			"type": "base64",
			"bytes": 48
		},
		{
			"key": "encryptionSecret",
			"label": "Encryption secret",
			"type": "base64",
			"bytes": 48
		},
		{
			"key": "cronSecret",
			"label": "Cron secret",
			"type": "base64",
			"bytes": 48
		},
		{
			"key": "adminEmail",
			"label": "Admin email",
			"type": "text",
			"default": "admin@example.com"
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_DB": "blogfactory",
				"POSTGRES_USER": "blogfactory",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "17.6-alpine3.22"
		},
		{
			"name": "minio",
			"dependsOn": [],
			"env": {
				"MINIO_ROOT_USER": "blogfactory",
				"MINIO_ROOT_PASSWORD": "${{ inputs.minioRootPassword }}"
			},
			"volumes": [
				{
					"name": "minio-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "minio/minio:RELEASE.2025-09-07T16-13-09Z",
			"command": [
				"server",
				"/data",
				"--console-address",
				":9001"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:9000/minio/health/live"
				]
			},
			"restart": "any"
		},
		{
			"name": "api",
			"dependsOn": [
				"postgres",
				"minio"
			],
			"env": {
				"NODE_ENV": "production",
				"PORT": "3000",
				"BLOGFACTORY_SELF_HOSTED": "true",
				"DATABASE_URL": "postgresql://blogfactory:${{ inputs.postgresPassword }}@${{ services.postgres.host }}:5432/blogfactory",
				"JWT_SECRET": "${{ inputs.jwtSecret }}",
				"API_KEY_ENCRYPTION_SECRET": "${{ inputs.encryptionSecret }}",
				"ADMIN_EMAILS": "${{ inputs.adminEmail }}",
				"BLOGFACTORY_ALLOW_SIGNUP": "true",
				"CRON_SECRET": "${{ inputs.cronSecret }}",
				"WEB_APP_URL": "https://${{ inputs.mainDomain }}",
				"MCP_APP_URL": "http://${{ services.web.host }}/mcp-review.html",
				"MCP_ALLOWED_ORIGINS": "https://${{ inputs.mainDomain }}",
				"S3_ENDPOINT": "http://${{ services.minio.host }}:9000",
				"S3_ACCESS_KEY_ID": "blogfactory",
				"S3_SECRET_ACCESS_KEY": "${{ inputs.minioRootPassword }}",
				"S3_BUCKET": "blogfactory",
				"S3_REGION": "us-east-1"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/blogfactoryhq/blogfactory-api:v0.1.0",
			"command": [
				"sh",
				"-c",
				"bun run src/init-s3-bucket.ts && bun run src/db/migrate.ts && exec bun run src/index.ts"
			],
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"bun",
					"-e",
					"fetch('http://localhost:3000/api/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
				]
			},
			"restart": "any"
		},
		{
			"name": "web",
			"dependsOn": [
				"api"
			],
			"env": {
				"API_UPSTREAM": "http://${{ services.api.host }}:3000"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/blogfactoryhq/blogfactory-web:v0.1.0",
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"nginx -t >/dev/null 2>&1 && wget -q -O /dev/null http://api:3000/api/ready"
				]
			},
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "scheduler",
			"dependsOn": [
				"api"
			],
			"env": {
				"CRON_SECRET": "${{ inputs.cronSecret }}",
				"CRON_INTERVAL_SECONDS": "21600"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "curlimages/curl:8.15.0",
			"command": [
				"while true; do curl --fail --silent --show-error --output /dev/null -H \"Authorization: Bearer ${CRON_SECRET}\" http://api:3000/api/cron/drain && echo \"Scheduler drain completed\"; sleep \"${CRON_INTERVAL_SECONDS}\"; done"
			],
			"entrypoint": [
				"/bin/sh",
				"-c"
			],
			"ports": [],
			"restart": "any"
		}
	]
}
