{
	"schema": 1,
	"id": "sparkyfitness",
	"name": "Sparkyfitness",
	"description": "SparkyFitness is a comprehensive fitness tracking and management application designed to help users monitor their nutrition, exercise, and body measurements. It provides tools for daily progress tracking, goal setting, and insightful reports to support a healthy lifestyle.",
	"category": "other",
	"tags": [
		"sparkyfitness",
		"fitness",
		"health",
		"nutrition",
		"exercise",
		"body measurements"
	],
	"docs": "https://codewithcj.github.io/SparkyFitness/",
	"version": "v1.6.1",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/sparkyfitness.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "sparkyfitnessDomain",
			"label": "Sparkyfitness domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "appdbpasswordPassword",
			"label": "Appdbpassword password",
			"type": "password",
			"length": 64
		},
		{
			"key": "serverapiencryptionkeyPassword",
			"label": "Serverapiencryptionkey password",
			"type": "password",
			"length": 64
		},
		{
			"key": "betterauthsecretPassword",
			"label": "Betterauthsecret password",
			"type": "password",
			"length": 64
		},
		{
			"key": "sparkyFitnessEmailUser",
			"label": "Sparky fitness email user",
			"type": "text",
			"default": ""
		},
		{
			"key": "sparkyFitnessEmailPass",
			"label": "Sparky fitness email pass",
			"type": "text",
			"default": ""
		}
	],
	"services": [
		{
			"name": "sparkyfitness-frontend",
			"dependsOn": [
				"sparkyfitness-server"
			],
			"env": {
				"SPARKY_FITNESS_FRONTEND_URL": "https://${{ inputs.sparkyfitnessDomain }}",
				"SPARKY_FITNESS_SERVER_HOST": "${{ services.sparkyfitness-server.host }}",
				"SPARKY_FITNESS_SERVER_PORT": "3010"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "codewithcj/sparkyfitness:v1.6.1",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "sparkyfitnessDomain"
			}
		},
		{
			"name": "sparkyfitness-server",
			"dependsOn": [
				"sparkyfitness-db"
			],
			"env": {
				"SPARKY_FITNESS_LOG_LEVEL": "info",
				"NODE_ENV": "production",
				"TZ": "Etc/UTC",
				"SPARKY_FITNESS_DB_USER": "${{ inputs.postgresUser }}",
				"SPARKY_FITNESS_DB_HOST": "${{ services.sparkyfitness-db.host }}",
				"SPARKY_FITNESS_DB_NAME": "sparkyfitness",
				"SPARKY_FITNESS_DB_PASSWORD": "${{ inputs.postgresPassword }}",
				"SPARKY_FITNESS_DB_PORT": "5432",
				"SPARKY_FITNESS_APP_DB_USER": "sparkyapp",
				"SPARKY_FITNESS_APP_DB_PASSWORD": "${{ inputs.appdbpasswordPassword }}",
				"SPARKY_FITNESS_API_ENCRYPTION_KEY": "${{ inputs.serverapiencryptionkeyPassword }}",
				"BETTER_AUTH_SECRET": "${{ inputs.betterauthsecretPassword }}",
				"SPARKY_FITNESS_FRONTEND_URL": "https://${{ inputs.sparkyfitnessDomain }}",
				"ALLOW_PRIVATE_NETWORK_CORS": "false",
				"SPARKY_FITNESS_EXTRA_TRUSTED_ORIGINS": "",
				"SPARKY_FITNESS_DISABLE_SIGNUP": "false",
				"SPARKY_FITNESS_FORCE_EMAIL_LOGIN": "true",
				"SPARKY_FITNESS_ADMIN_EMAIL": "admin@example.com",
				"SPARKY_FITNESS_EMAIL_HOST": "smtp.gmail.com",
				"SPARKY_FITNESS_EMAIL_PORT": "587",
				"SPARKY_FITNESS_EMAIL_SECURE": "false",
				"SPARKY_FITNESS_EMAIL_USER": "${{ inputs.sparkyFitnessEmailUser }}",
				"SPARKY_FITNESS_EMAIL_PASS": "${{ inputs.sparkyFitnessEmailPass }}",
				"SPARKY_FITNESS_EMAIL_FROM": "\"Sparky Fitness <noreply@sparkyfitness.com>\""
			},
			"volumes": [
				{
					"name": "sparkyfitness-server-backup",
					"target": "/app/SparkyFitnessServer/backup"
				},
				{
					"name": "sparkyfitness-server-uploads",
					"target": "/app/SparkyFitnessServer/uploads"
				}
			],
			"files": [],
			"kind": "application",
			"image": "codewithcj/sparkyfitness_server:v1.6.1",
			"ports": []
		},
		{
			"name": "sparkyfitness-db",
			"dependsOn": [],
			"env": {
				"POSTGRES_DB": "sparkyfitness",
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_PORT": "5432"
			},
			"volumes": [
				{
					"name": "sparkyfitness-db-postgresql",
					"target": "/var/lib/postgresql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "postgres:18-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"
				]
			}
		}
	]
}
