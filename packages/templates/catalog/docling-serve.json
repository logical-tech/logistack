{
	"schema": 1,
	"id": "docling-serve",
	"name": "Docling Serve",
	"description": "Running Docling as an API service for document processing and conversion with AI-powered capabilities.",
	"category": "devtools",
	"tags": [
		"document-processing",
		"api",
		"ai",
		"conversion",
		"pdf",
		"office"
	],
	"docs": "https://github.com/docling-project/docling-serve/blob/main/docs/README.md",
	"version": "sha256:8a5fbc993da9",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/docling-serve",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "docling-serve",
			"dependsOn": [],
			"env": {
				"DOCLING_SERVE_ENABLE_UI": "1",
				"DOCLING_SERVE_HOST": "0.0.0.0",
				"DOCLING_SERVE_PORT": "5001"
			},
			"volumes": [
				{
					"name": "docling-data",
					"target": "/app/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "quay.io/docling-project/docling-serve@sha256:8a5fbc993da9dec17c53880e2445834591ad26800ef698ca64096bef29671808",
			"ports": [
				{
					"target": 5001,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:5001/health"
				]
			},
			"public": {
				"port": 5001,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
