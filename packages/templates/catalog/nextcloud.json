{
	"schema": 1,
	"id": "nextcloud",
	"name": "Nextcloud",
	"description": "NextCloud is a self-hosted, open-source platform that provides file storage, collaboration, and communication tools for seamless data management.",
	"category": "storage",
	"tags": [
		"cloud",
		"collaboration",
		"communication",
		"filestorage",
		"data"
	],
	"logo": "logos/nextcloud.svg",
	"docs": "https://docs.nextcloud.com/",
	"version": "sha256:b980e092ea0c",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/nextcloud.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "nextcloudDomain",
			"label": "Nextcloud domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "timezone",
			"label": "Timezone",
			"description": "IANA time zone, for example Europe/Rome.",
			"type": "text",
			"default": "UTC"
		}
	],
	"services": [
		{
			"name": "nextcloud",
			"dependsOn": [],
			"env": {
				"PUID": "1000",
				"PGID": "1000",
				"TZ": "${{ inputs.timezone }}"
			},
			"volumes": [
				{
					"name": "nextcloud-config",
					"target": "/config"
				},
				{
					"name": "nextcloud-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lscr.io/linuxserver/nextcloud@sha256:b980e092ea0ce7b509b8c1f03b8b5ae244348faccd4ae9e519d61e32706aa20a",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:80/status.php"
				]
			},
			"public": {
				"port": 80,
				"domain": "nextcloudDomain"
			}
		}
	]
}
