{
	"schema": 1,
	"id": "nitropage-with-postgresql",
	"name": "Nitropage With Postgresql",
	"description": "Nitropage is an extensible, visual website builder, offering a growing library of versatile building blocks, focal-point image cropping and sovereign font management.",
	"category": "cms",
	"tags": [
		"nitropage",
		"builder",
		"editor",
		"wysiwyg",
		"cms",
		"content",
		"management"
	],
	"logo": "logos/nitropage-with-postgresql.svg",
	"docs": "https://nitropage.org/",
	"version": "sha256:fe479b95d868",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/nitropage-with-postgresql.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "nitropageDomain",
			"label": "Nitropage domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "saltSecret",
			"label": "Salt secret",
			"type": "secret",
			"length": 32,
			"charset": "alnum"
		},
		{
			"key": "sessionPassword",
			"label": "Session password",
			"type": "password",
			"length": 64
		},
		{
			"key": "postgresqlUser",
			"label": "Postgresql user",
			"type": "username"
		},
		{
			"key": "postgresqlPassword",
			"label": "Postgresql password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "nitropage",
			"dependsOn": [
				"postgresql"
			],
			"env": {
				"NP_AUTH_SALT": "${{ inputs.saltSecret }}",
				"NP_AUTH_PASSWORD": "${{ inputs.sessionPassword }}",
				"DATABASE_URL": "postgresql://${{ inputs.postgresqlUser }}:${{ inputs.postgresqlPassword }}@${{ services.postgresql.host }}:5432/nitropage"
			},
			"volumes": [
				{
					"name": "nitropage-data",
					"target": "/app/.data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "nitropage/nitropage@sha256:fe479b95d86851d790913c46a248cc19dca5c2a246e2509d95f46ee193df75b1",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:3000/admin"
				]
			},
			"public": {
				"port": 3000,
				"domain": "nitropageDomain"
			}
		},
		{
			"name": "postgresql",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresqlUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresqlPassword }}",
				"POSTGRES_DB": "nitropage"
			},
			"volumes": [
				{
					"name": "nitropage-postgresql-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		}
	]
}
