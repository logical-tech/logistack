{
	"schema": 1,
	"id": "supertokens-with-mysql",
	"name": "Supertokens With Mysql",
	"description": "An open-source authentication solution that simplifies the implementation of secure user authentication and session management for web and mobile applications.",
	"category": "security",
	"tags": [
		"supertokens",
		"login",
		"authentication",
		"authorization",
		"oauth",
		"user-management",
		"session-management",
		"access-control",
		"otp",
		"magic-link",
		"passwordless"
	],
	"logo": "logos/supertokens-with-mysql.svg",
	"docs": "https://supertokens.com/docs/guides",
	"version": "sha256:3415a632603f",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/supertokens-with-mysql.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "supertokensDomain",
			"label": "Supertokens domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "mysqlUser",
			"label": "Mysql user",
			"type": "username"
		},
		{
			"key": "mysqlPassword",
			"label": "Mysql password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "supertokens",
			"dependsOn": [
				"mysql"
			],
			"env": {
				"API_KEYS": "",
				"MYSQL_CONNECTION_URI": "mysql://${{ inputs.mysqlUser }}:${{ inputs.mysqlPassword }}@${{ services.mysql.host }}:3306/supertokens"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "registry.supertokens.io/supertokens/supertokens-mysql@sha256:3415a632603f1bab91aaff42d834b223d9d6ef8e92c5829ef12ae6505f92f9a6",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"bash -c 'exec 3<>/dev/tcp/127.0.0.1/3567 && echo -e \"GET /hello HTTP/1.1\\r\\nhost: 127.0.0.1:3567\\r\\nConnection: close\\r\\n\\r\\n\" >&3 && cat <&3 | grep \"Hello\"'\n"
				]
			},
			"public": {
				"port": 3567,
				"domain": "supertokensDomain"
			}
		},
		{
			"name": "mysql",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.mysqlPassword }}",
				"MYSQL_USER": "${{ inputs.mysqlUser }}",
				"MYSQL_PASSWORD": "${{ inputs.mysqlPassword }}",
				"MYSQL_DATABASE": "supertokens"
			},
			"volumes": [
				{
					"name": "supertokens-mysql-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mysql@sha256:3819b2b23835c4a73c8b022fafc33c8095c0f81c929a8b7a84613d2fba6c52f5",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"mysqladmin",
					"ping",
					"-h",
					"localhost"
				]
			}
		}
	]
}
