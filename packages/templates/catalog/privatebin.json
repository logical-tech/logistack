{
	"schema": 1,
	"id": "privatebin",
	"name": "PrivateBin",
	"description": "PrivateBin is a minimalist, open-source online pastebin where the server has zero knowledge of pasted data.",
	"category": "security",
	"tags": [
		"pastebin",
		"privacy",
		"self-hosted",
		"text",
		"sharing"
	],
	"logo": "logos/privatebin.svg",
	"website": "https://privatebin.info/",
	"docs": "https://github.com/PrivateBin/docker-nginx-fpm-alpine",
	"version": "2.0.4",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/privatebin",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "privatebin",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "privatebin-data",
					"target": "/srv/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "privatebin/nginx-fpm-alpine:2.0.4",
			"ports": [
				{
					"target": 8080,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 8080,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
