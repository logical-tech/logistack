{
	"schema": 1,
	"id": "yourls",
	"name": "YOURLS",
	"description": "YOURLS (Your Own URL Shortener) is a set of PHP scripts that will allow you to run your own URL shortening service (a la TinyURL or Bitly).",
	"category": "other",
	"tags": [
		"url-shortener",
		"php"
	],
	"logo": "logos/yourls.svg",
	"website": "https://yourls.org/",
	"docs": "https://yourls.org/#documentation",
	"version": "1.9.2",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/yourls",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "adminPassword",
			"label": "Admin password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mysqlPassword",
			"label": "Mysql password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mysqlRootPassword",
			"label": "Mysql root password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "yourls-app",
			"dependsOn": [
				"yourls-mysql"
			],
			"env": {
				"YOURLS_SITE": "https://${{ inputs.mainDomain }}",
				"YOURLS_USER": "admin",
				"YOURLS_PASS": "${{ inputs.adminPassword }}",
				"YOURLS_DB_HOST": "${{ services.yourls-mysql.host }}",
				"YOURLS_DB_USER": "yourls",
				"YOURLS_DB_PASS": "${{ inputs.mysqlPassword }}",
				"YOURLS_DB_NAME": "yourls"
			},
			"volumes": [
				{
					"name": "yourls-data",
					"target": "/var/www/html"
				}
			],
			"files": [],
			"kind": "application",
			"image": "yourls:1.9.2",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "yourls-mysql",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.mysqlRootPassword }}",
				"MYSQL_DATABASE": "yourls",
				"MYSQL_USER": "yourls",
				"MYSQL_PASSWORD": "${{ inputs.mysqlPassword }}"
			},
			"volumes": [
				{
					"name": "yourls-mysql-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mysql",
			"version": "5.7"
		}
	]
}
