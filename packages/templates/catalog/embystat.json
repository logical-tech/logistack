{
	"schema": 1,
	"id": "embystat",
	"name": "Embystat",
	"description": "EmbyStat is a web analytics tool, designed to provide insight into website traffic and user behavior.",
	"category": "analytics",
	"tags": [
		"analytics",
		"insights",
		"statistics",
		"web",
		"traffic"
	],
	"docs": "https://github.com/mregni/EmbyStat",
	"version": "sha256:adc479353fc0",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/embystat.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "embystatDomain",
			"label": "Embystat domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "embystat",
			"dependsOn": [],
			"env": {
				"PUID": "1000",
				"PGID": "1000",
				"TZ": "Europe/Madrid"
			},
			"volumes": [
				{
					"name": "embystat-config",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lscr.io/linuxserver/embystat@sha256:adc479353fc0b810c21935a8fe3c2d20d9f7027edc9574477d702ec2ad414754",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://127.0.0.1:6555"
				]
			},
			"public": {
				"port": 6555,
				"domain": "embystatDomain"
			}
		}
	]
}
