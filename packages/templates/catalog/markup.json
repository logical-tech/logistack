{
	"schema": 1,
	"id": "markup",
	"name": "Markup",
	"description": "Markup is a fast, keyboard-first markdown workspace with live preview, graph view, whiteboards, mind maps, and PostgreSQL-powered cloud sync.",
	"category": "productivity",
	"tags": [
		"markdown",
		"notes",
		"editor",
		"self-hosted"
	],
	"logo": "logos/markup.svg",
	"website": "https://home.markup.freddiephilpot.dev/",
	"docs": "https://docs.markup.freddiephilpot.dev/",
	"version": "sha256:c1f07da043aa",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/markup",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "cookiePassword",
			"label": "Cookie password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "db",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "markup",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "markup"
			},
			"volumes": [
				{
					"name": "markup-postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "16-alpine"
		},
		{
			"name": "markup",
			"dependsOn": [
				"db"
			],
			"env": {
				"DATABASE_URL": "postgresql://markup:${{ inputs.postgresPassword }}@${{ services.db.host }}:5432/markup",
				"NEXT_PUBLIC_DB_PROVIDER": "postgres",
				"NEXT_PUBLIC_SITE_URL": "https://${{ inputs.mainDomain }}",
				"WORKOS_CLIENT_ID": "client_id_change_me",
				"WORKOS_API_KEY": "sk_change_me",
				"WORKOS_COOKIE_PASSWORD": "${{ inputs.cookiePassword }}",
				"NEXT_PUBLIC_WORKOS_REDIRECT_URI": "https://${{ inputs.mainDomain }}/callback",
				"NODE_ENV": "production"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/pphilfre/markup@sha256:c1f07da043aac89f9490c92f52dd66120b25a919802f06eb5f2427a09dad085f",
			"ports": [],
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
