{
	"schema": 1,
	"id": "siyuan",
	"name": "Siyuan",
	"description": "A privacy-first, self-hosted, fully open source personal knowledge management software, written in typescript and golang.",
	"category": "productivity",
	"tags": [
		"note-taking",
		"markdown",
		"pkm"
	],
	"logo": "logos/siyuan.svg",
	"docs": "https://github.com/siyuan-note/siyuan",
	"version": "v3.3.5",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/siyuan.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "siyuanDomain",
			"label": "Siyuan domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "siyuanPassword",
			"label": "Siyuan password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "siyuan",
			"dependsOn": [],
			"env": {
				"TZ": "UTC",
				"PUID": "1000",
				"PGID": "1000",
				"SIYUAN_ACCESS_AUTH_CODE": "${{ inputs.siyuanPassword }}"
			},
			"volumes": [
				{
					"name": "siyuan-workspace",
					"target": "/siyuan/workspace"
				}
			],
			"files": [],
			"kind": "application",
			"image": "b3log/siyuan:v3.3.5",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"--spider",
					"--quiet",
					"http://127.0.0.1:6806/api/system/version"
				]
			},
			"public": {
				"port": 6806,
				"domain": "siyuanDomain"
			}
		}
	]
}
