{
	"schema": 1,
	"id": "grimmory",
	"name": "Grimmory",
	"description": "Grimmory is a self-hosted application for managing your entire book collection in one place. Organize, read, annotate, sync across devices, and share without relying on third-party services.",
	"category": "other",
	"tags": [
		"books",
		"ebooks",
		"library",
		"reader"
	],
	"logo": "logos/grimmory.svg",
	"docs": "https://github.com/grimmory-tools/grimmory",
	"version": "nightly-20260403-3a371f7",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/grimmory.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "grimmoryDomain",
			"label": "Grimmory domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "mariadbUser",
			"label": "Mariadb user",
			"type": "username"
		},
		{
			"key": "mariadbPassword",
			"label": "Mariadb password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mariadbrootPassword",
			"label": "Mariadbroot password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "grimmory",
			"dependsOn": [
				"mariadb"
			],
			"env": {
				"USER_ID": "0",
				"GROUP_ID": "0",
				"TZ": "UTC",
				"DATABASE_URL": "jdbc:mariadb://${{ services.mariadb.host }}:3306/grimmory-db",
				"DATABASE_USERNAME": "${{ inputs.mariadbUser }}",
				"DATABASE_PASSWORD": "${{ inputs.mariadbPassword }}",
				"BOOKLORE_PORT": "80"
			},
			"volumes": [
				{
					"name": "grimmory-data",
					"target": "/app/data"
				},
				{
					"name": "grimmory-books",
					"target": "/books"
				},
				{
					"name": "grimmory-bookdrop",
					"target": "/bookdrop"
				}
			],
			"files": [],
			"kind": "application",
			"image": "grimmory/grimmory:nightly-20260403-3a371f7",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1"
				]
			},
			"public": {
				"port": 80,
				"domain": "grimmoryDomain"
			}
		},
		{
			"name": "mariadb",
			"dependsOn": [],
			"env": {
				"MARIADB_USER": "${{ inputs.mariadbUser }}",
				"MARIADB_PASSWORD": "${{ inputs.mariadbPassword }}",
				"MARIADB_ROOT_PASSWORD": "${{ inputs.mariadbrootPassword }}",
				"MARIADB_DATABASE": "grimmory-db"
			},
			"volumes": [
				{
					"name": "mariadb-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mariadb",
			"version": "12"
		}
	]
}
