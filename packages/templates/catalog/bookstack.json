{
	"schema": 1,
	"id": "bookstack",
	"name": "BookStack",
	"description": "BookStack is a wiki platform for organizing documentation.",
	"category": "productivity",
	"tags": [
		"documentation",
		"self-hosted",
		"free-and-open-source",
		"mfa",
		"dark-light-themes",
		"searchable",
		"connected",
		"simple-interface",
		"diagramms",
		"notes"
	],
	"logo": "logos/bookstack.svg",
	"website": "https://www.bookstackapp.com/",
	"docs": "https://www.bookstackapp.com/docs",
	"version": "24.12.1",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/bookstack",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 16
		},
		{
			"key": "appKey",
			"label": "App key",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "bookstack",
			"dependsOn": [
				"bookstack-db"
			],
			"env": {
				"PUID": "1000",
				"PGID": "1000",
				"APP_URL": "https://${{ inputs.mainDomain }}",
				"DB_HOST": "${{ services.bookstack-db.host }}",
				"DB_USERNAME": "mariadb",
				"DB_PASSWORD": "${{ inputs.dbPassword }}",
				"DB_DATABASE": "bookstack",
				"APP_KEY": "${{ inputs.appKey }}"
			},
			"volumes": [
				{
					"name": "config",
					"target": "/config"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lscr.io/linuxserver/bookstack:24.12.1",
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 80,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "bookstack-db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.dbPassword }}",
				"MYSQL_DATABASE": "bookstack",
				"MYSQL_USER": "mariadb",
				"MYSQL_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "db-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mariadb:10.11",
			"ports": [],
			"restart": "any"
		}
	]
}
