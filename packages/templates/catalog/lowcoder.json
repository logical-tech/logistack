{
	"schema": 1,
	"id": "lowcoder",
	"name": "Lowcoder",
	"description": "Rapid business App Builder for Everyone",
	"category": "devtools",
	"tags": [
		"low-code",
		"no-code",
		"development",
		"lowcoder",
		"openblocks",
		"low",
		"code",
		"platform",
		"open",
		"source"
	],
	"logo": "logos/lowcoder.png",
	"website": "https://www.lowcoder.cloud/",
	"docs": "https://docs.lowcoder.cloud/lowcoder-documentation",
	"version": "2.6.4",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/lowcoder",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "encryptionPassword",
			"label": "Encryption password",
			"type": "password",
			"length": 32
		},
		{
			"key": "encryptionSalt",
			"label": "Encryption salt",
			"type": "password",
			"length": 32
		},
		{
			"key": "apiSecret",
			"label": "API secret",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "lowcoder-api-service",
			"dependsOn": [],
			"env": {
				"REDIS_ENABLED": "true",
				"MONGODB_ENABLED": "true",
				"API_SERVICE_ENABLED": "true",
				"NODE_SERVICE_ENABLED": "true",
				"FRONTEND_ENABLED": "true",
				"PUID": "1000",
				"PGID": "1000",
				"DEFAULT_ORGS_PER_USER": "100",
				"DEFAULT_ORG_MEMBER_COUNT": "1000",
				"DEFAULT_ORG_GROUP_COUNT": "100",
				"DEFAULT_ORG_APP_COUNT": "1000",
				"DEFAULT_DEVELOPER_COUNT": "50",
				"MONGODB_URL": "mongodb://localhost:27017/lowcoder?authSource=admin",
				"REDIS_URL": "redis://localhost:6379",
				"ENABLE_USER_SIGN_UP": "false",
				"ENCRYPTION_PASSWORD": "${{ inputs.encryptionPassword }}",
				"ENCRYPTION_SALT": "${{ inputs.encryptionSalt }}",
				"CORS_ALLOWED_DOMAINS": "*",
				"LOWCODER_API_KEY_SECRET": "${{ inputs.apiSecret }}",
				"LOWCODER_API_SERVICE_URL": "http://localhost:8080",
				"LOWCODER_NODE_SERVICE_URL": "http://localhost:6060"
			},
			"volumes": [
				{
					"name": "files-volumes-lowcoder-stacks",
					"target": "/lowcoder-stacks"
				}
			],
			"files": [],
			"kind": "application",
			"image": "lowcoderorg/lowcoder-ce:2.6.4",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
