{
	"schema": 1,
	"id": "directory-lister",
	"name": "Directory Lister",
	"description": "Directory Lister is a simple PHP application that lists the contents of any web-accessible directory and allows navigation there within.",
	"category": "other",
	"tags": [
		"file-manager",
		"directory-listing",
		"php"
	],
	"logo": "logos/directory-lister.png",
	"website": "https://www.directorylister.com/",
	"docs": "https://docs.directorylister.com/",
	"version": "sha256:5498c8cc29d6",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/directory-lister",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "appDomain",
			"label": "App domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "directory-lister",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "directory-lister-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "directorylister/directorylister@sha256:5498c8cc29d650601c3f4ef8e4f35ab1b533951180dee958aa2bdeeab775ff58",
			"ports": [
				{
					"target": 80,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 80,
				"domain": "appDomain"
			},
			"restart": "any"
		}
	]
}
