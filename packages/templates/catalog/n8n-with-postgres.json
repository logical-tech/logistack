{
	"schema": 1,
	"id": "n8n-with-postgres",
	"name": "n8n with Postgres",
	"description": "n8n is an open source low-code platform for automating workflows and integrations with PostgreSQL database for better performance and scalability.",
	"category": "automation",
	"tags": [
		"automation",
		"workflow",
		"low-code",
		"postgres"
	],
	"logo": "logos/n8n-with-postgres.png",
	"website": "https://n8n.io/",
	"docs": "https://docs.n8n.io/",
	"version": "sha256:4384b9ff20a7",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/n8n-with-postgres",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 24
		},
		{
			"key": "n8nEncryptionKey",
			"label": "N8n encryption key",
			"type": "base64",
			"bytes": 64
		},
		{
			"key": "timezone",
			"label": "Timezone",
			"description": "IANA time zone, for example Europe/Rome.",
			"type": "text",
			"default": "UTC"
		}
	],
	"services": [
		{
			"name": "postgres",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "n8n"
			},
			"volumes": [
				{
					"name": "postgres-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "postgres",
			"version": "17-alpine"
		},
		{
			"name": "n8n",
			"dependsOn": [
				"postgres"
			],
			"env": {
				"DB_TYPE": "postgresdb",
				"DB_POSTGRESDB_HOST": "${{ services.postgres.host }}",
				"DB_POSTGRESDB_PORT": "5432",
				"DB_POSTGRESDB_DATABASE": "n8n",
				"DB_POSTGRESDB_USER": "${{ inputs.postgresUser }}",
				"DB_POSTGRESDB_PASSWORD": "${{ inputs.postgresPassword }}",
				"N8N_ENCRYPTION_KEY": "${{ inputs.n8nEncryptionKey }}",
				"N8N_HOST": "${{ inputs.mainDomain }}",
				"N8N_PORT": "5678",
				"N8N_PROTOCOL": "http",
				"NODE_ENV": "production",
				"WEBHOOK_URL": "https://${{ inputs.mainDomain }}/",
				"GENERIC_TIMEZONE": "${{ inputs.timezone }}",
				"N8N_PROXY_HOPS": "1"
			},
			"volumes": [
				{
					"name": "n8n-data",
					"target": "/home/node/.n8n"
				}
			],
			"files": [],
			"kind": "application",
			"image": "n8nio/n8n@sha256:4384b9ff20a78bc1708c35ce7864f84f724611de7801fb36d715998db7c000f1",
			"ports": [],
			"public": {
				"port": 5678,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
