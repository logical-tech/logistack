{
	"schema": 1,
	"id": "rocketchat",
	"name": "Rocketchat",
	"description": "Self-hosted, secure and highly customizable open-source communication platform for organizations with sophisticated security and privacy concerns.",
	"category": "communication",
	"tags": [
		"rocketchat",
		"chat",
		"communication",
		"privacy",
		"mongodb",
		"open",
		"source"
	],
	"logo": "logos/rocketchat.svg",
	"website": "https://rocket.chat/",
	"docs": "https://github.com/RocketChat/Rocket.Chat",
	"version": "8.0.1",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/rocketchat.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "rocketchatDomain",
			"label": "Rocketchat domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "regToken",
			"label": "Reg token",
			"type": "text",
			"default": ""
		}
	],
	"services": [
		{
			"name": "rocketchat",
			"dependsOn": [
				"mongodb"
			],
			"env": {
				"MONGO_URL": "mongodb://${{ services.mongodb.host }}:27017/rocketchat?replicaSet=rs0",
				"MONGO_OPLOG_URL": "mongodb://${{ services.mongodb.host }}:27017/local?replicaSet=rs0",
				"ROOT_URL": "https://${{ inputs.rocketchatDomain }}",
				"DEPLOY_METHOD": "docker",
				"REG_TOKEN": "${{ inputs.regToken }}",
				"MAIL_URL": "test@example.com"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "registry.rocket.chat/rocketchat/rocket.chat:8.0.1",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"node",
					"--eval",
					"const http = require('http'); const options = { host: '0.0.0.0', port: 3000, timeout: 2000, path: '/health' }; const healthCheck = http.request(options, (res) => { console.log('HEALTHCHECK STATUS:', res.statusCode); if (res.statusCode == 200) { process.exit(0); } else { process.exit(1); } }); healthCheck.on('error', function (err) { console.error('ERROR'); process.exit(1); }); healthCheck.end();"
				]
			},
			"public": {
				"port": 3000,
				"domain": "rocketchatDomain"
			}
		},
		{
			"name": "mongodb",
			"dependsOn": [],
			"env": {},
			"volumes": [
				{
					"name": "mongodb-data",
					"target": "/data/db"
				}
			],
			"files": [],
			"kind": "application",
			"image": "mongo:7",
			"command": [
				"sh",
				"-c",
				"\n  mongod --replSet rs0 --bind_ip_all &\n  sleep 5 &&\n  mongosh --eval 'rs.initiate({_id:\"rs0\", members:[{_id:0, host:\"mongodb:27017\"}]})' ||\n  true &&\n  wait\n"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"mongosh",
					"--quiet",
					"--eval",
					"db.adminCommand('ping')"
				]
			}
		}
	]
}
