{
	"schema": 1,
	"id": "executor",
	"name": "Executor",
	"description": "Self-hosted AI agent integrations and code execution server.",
	"category": "devtools",
	"tags": [
		"executor",
		"ai",
		"agents",
		"mcp",
		"automation",
		"development"
	],
	"docs": "https://executor.sh/docs/hosted/docker",
	"version": "sha256:b9e001775d3e",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/executor.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "executorDomain",
			"label": "Executor domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "executor",
			"dependsOn": [],
			"env": {
				"EXECUTOR_WEB_BASE_URL": "https://${{ inputs.executorDomain }}",
				"EXECUTOR_HOST": "0.0.0.0",
				"PORT": "4788",
				"EXECUTOR_DATA_DIR": "/data",
				"EXECUTOR_DB_PATH": "/data/data.db",
				"EXECUTOR_ORG_NAME": "Default",
				"EXECUTOR_ORG_SLUG": "default",
				"EXECUTOR_ALLOW_LOCAL_NETWORK": "false"
			},
			"volumes": [
				{
					"name": "executor-data",
					"target": "/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/rhyssullivan/executor-selfhost@sha256:b9e001775d3eb7d662d347c8f7054333c78c1a4fd97cb5a86dc1d1d1406093b9",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"bun",
					"-e",
					"fetch(`http://127.0.0.1:${process.env.PORT||4788}/api/health`).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
				]
			},
			"public": {
				"port": 4788,
				"domain": "executorDomain"
			}
		}
	]
}
