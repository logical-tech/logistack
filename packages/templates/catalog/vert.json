{
	"schema": 1,
	"id": "vert",
	"name": "Vert",
	"description": "The next-generation file converter. Open source, fully local and free forever.",
	"category": "devtools",
	"tags": [
		"converter",
		"file",
		"documents",
		"files",
		"ffmpeg",
		"wasm"
	],
	"logo": "logos/vert.png",
	"docs": "https://github.com/VERT-sh/VERT",
	"version": "sha256:51edb89e7c57",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/vert.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "vertDomain",
			"label": "Vert domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "vert",
			"dependsOn": [],
			"env": {
				"PUB_VERT_URL": "https://${{ inputs.vertDomain }}",
				"PUB_HOSTNAME": "https://${{ inputs.vertDomain }}",
				"PUB_PORT": "80",
				"PUB_ENV": "production"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/vert-sh/vert@sha256:51edb89e7c57197b0281ba8427fb27eea63730a3683b10d422061afab2708a49",
			"ports": [],
			"public": {
				"port": 80,
				"domain": "vertDomain"
			}
		}
	]
}
