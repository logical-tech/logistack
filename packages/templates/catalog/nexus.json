{
	"schema": 1,
	"id": "nexus",
	"name": "Nexus",
	"description": "Open source Universal Repository Manager (x86_64 version, official), default credentials: admin/admin123",
	"category": "devtools",
	"tags": [
		"repository",
		"manager",
		"open source",
		"docker",
		"registry",
		"container"
	],
	"logo": "logos/nexus.png",
	"docs": "https://help.sonatype.com/en/sonatype-nexus-repository.html",
	"version": "sha256:26aaefb94d3f",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/nexus.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "nexusDomain",
			"label": "Nexus domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "nexus",
			"dependsOn": [],
			"env": {
				"NEXUS_SECURITY_RANDOMPASSWORD": "false",
				"INSTALL4J_ADD_VM_PARAMS": "-Xms2703m -Xmx2703m -XX:MaxDirectMemorySize=2703m -Djava.util.prefs.userRoot=/nexus-data/javaprefs"
			},
			"volumes": [
				{
					"name": "nexus-data",
					"target": "/nexus-data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "sonatype/nexus3@sha256:26aaefb94d3fae6d18161a26a9eb5cdf25ce9401ea095f41e8ad5e5cf86b3a20",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"curl",
					"-f",
					"http://localhost:8081/service/rest/v1/status"
				]
			},
			"public": {
				"port": 8081,
				"domain": "nexusDomain"
			}
		}
	]
}
