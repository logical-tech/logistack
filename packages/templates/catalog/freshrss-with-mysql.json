{
	"schema": 1,
	"id": "freshrss-with-mysql",
	"name": "Freshrss With Mysql",
	"description": "A free, self-hostable feed aggregator.",
	"category": "communication",
	"tags": [
		"rss",
		"feed"
	],
	"logo": "logos/freshrss-with-mysql.png",
	"docs": "https://freshrss.org/index.html",
	"version": "sha256:af4438522954",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/freshrss-with-mysql.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "freshrssDomain",
			"label": "Freshrss domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "mysqlUser",
			"label": "Mysql user",
			"type": "username"
		},
		{
			"key": "mysqlPassword",
			"label": "Mysql password",
			"type": "password",
			"length": 32
		},
		{
			"key": "rootPassword",
			"label": "Root password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "freshrss",
			"dependsOn": [
				"freshrss-db"
			],
			"env": {
				"CRON_MIN": "1,31",
				"MYSQL_DB": "freshrss",
				"MYSQL_USER": "${{ inputs.mysqlUser }}",
				"MYSQL_PASSWORD": "${{ inputs.mysqlPassword }}"
			},
			"volumes": [
				{
					"name": "freshrss-data",
					"target": "/var/www/FreshRSS/data"
				},
				{
					"name": "freshrss-extensions",
					"target": "/var/www/FreshRSS/extensions"
				}
			],
			"files": [],
			"kind": "application",
			"image": "freshrss/freshrss@sha256:af44385229541bee24aa9148d0ff8f3b40e095373c63a2c0f74e09a27d3c59df",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"bash -c ':> /dev/tcp/127.0.0.1/80' || exit 1"
				]
			},
			"public": {
				"port": 80,
				"domain": "freshrssDomain"
			}
		},
		{
			"name": "freshrss-db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.rootPassword }}",
				"MYSQL_DATABASE": "freshrss",
				"MYSQL_USER": "${{ inputs.mysqlUser }}",
				"MYSQL_PASSWORD": "${{ inputs.mysqlPassword }}"
			},
			"volumes": [
				{
					"name": "mysql-data",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mysql",
			"version": "8"
		}
	]
}
