{
	"schema": 1,
	"id": "weaviate",
	"name": "Weaviate",
	"description": "Weaviate is an open-source vector database that stores both objects and vectors, allowing for combining vector search with structured filtering.",
	"category": "ai",
	"tags": [
		"ai",
		"vector-database",
		"semantic-search",
		"machine-learning",
		"bm25",
		"embeddings",
		"llm"
	],
	"logo": "logos/weaviate.png",
	"docs": "https://weaviate.io/developers/weaviate",
	"version": "1.26.4",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/weaviate.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "weaviateDomain",
			"label": "Weaviate domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "apikeysPassword",
			"label": "Apikeys password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "weaviate",
			"dependsOn": [],
			"env": {
				"DISABLE_TELEMETRY": "true",
				"QUERY_DEFAULTS_LIMIT": "1000",
				"LOG_LEVEL": "info",
				"GOMEMLIMIT": "1024MiB",
				"GOMAXPROCS": "2",
				"AUTHENTICATION_ANONYMOUS_ACCESS_ENABLED": "false",
				"AUTHORIZATION_ADMINLIST_USERS": "admin@example.com",
				"AUTHENTICATION_APIKEY_USERS": "admin@example.com",
				"AUTHENTICATION_APIKEY_ENABLED": "true",
				"AUTHENTICATION_APIKEY_ALLOWED_KEYS": "${{ inputs.apikeysPassword }}",
				"PERSISTENCE_DATA_PATH": "/var/lib/weaviate",
				"DEFAULT_VECTORIZER_MODULE": "none",
				"ENABLE_MODULES": "text2vec-openai,generative-openai,qna-openai",
				"CLUSTER_HOSTNAME": "node1"
			},
			"volumes": [
				{
					"name": "weaviate-data",
					"target": "/var/lib/weaviate"
				}
			],
			"files": [],
			"kind": "application",
			"image": "cr.weaviate.io/semitechnologies/weaviate:1.26.4",
			"command": [
				"--host",
				"0.0.0.0",
				"--port",
				"8080",
				"--scheme",
				"http"
			],
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"-q",
					"--spider",
					"http://localhost:8080/v1/.well-known/ready"
				]
			},
			"public": {
				"port": 8080,
				"domain": "weaviateDomain"
			}
		}
	]
}
