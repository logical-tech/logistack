{
	"schema": 1,
	"id": "nodelink",
	"name": "NodeLink",
	"description": "NodeLink is a lightweight Lavalink-compatible audio server built in Node.js for Discord music bots and real-time audio systems.",
	"category": "media",
	"tags": [
		"audio",
		"discord",
		"lavalink",
		"music"
	],
	"logo": "logos/nodelink.svg",
	"website": "https://nodelink.js.org/",
	"docs": "https://nodelink.js.org/docs/advanced/docker",
	"version": "3.8.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/nodelink",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "serverPassword",
			"label": "Server password",
			"type": "password",
			"length": 32
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "nodelink",
			"dependsOn": [],
			"env": {
				"NODELINK_SERVER_HOST": "0.0.0.0",
				"NODELINK_SERVER_PORT": "2333",
				"NODELINK_SERVER_PASSWORD": "${{ inputs.serverPassword }}",
				"NODELINK_LOGGING_LEVEL": "info",
				"NODELINK_LOGGING_FILE_ENABLED": "false",
				"NODELINK_SOURCES_LOCAL_ENABLED": "false",
				"NODELINK_SOURCES_LOCAL_BASEPATH": "/app/local-music/",
				"NODELINK_METRICS_ENABLED": "false"
			},
			"volumes": [
				{
					"name": "nodelink-cache",
					"target": "/app/.cache"
				},
				{
					"name": "nodelink-local-music",
					"target": "/app/local-music"
				},
				{
					"name": "nodelink-logs",
					"target": "/app/logs"
				}
			],
			"files": [],
			"kind": "application",
			"image": "performanc/nodelink:3.8.0",
			"ports": [
				{
					"target": 2333,
					"protocol": "tcp"
				}
			],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"node -e \"fetch('http://127.0.0.1:2333/version',{headers:{authorization:process.env.NODELINK_SERVER_PASSWORD||''}}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
				]
			},
			"public": {
				"port": 2333,
				"domain": "mainDomain"
			},
			"restart": "any"
		}
	]
}
