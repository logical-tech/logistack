{
	"schema": 1,
	"id": "martin",
	"name": "Martin",
	"description": "Martin is a tile server able to generate and serve vector tiles on the fly from large PostGIS databases, PMTiles (local or remote), and MBTiles files, allowing multiple tile sources to be dynamically combined into one.",
	"category": "devtools",
	"tags": [
		"postgis",
		"vector",
		"tiles"
	],
	"docs": "https://maplibre.org/martin/introduction.html/",
	"version": "v0.13.0",
	"source": {
		"kind": "coolify",
		"path": "templates/compose/martin.yaml",
		"license": "Apache-2.0"
	},
	"inputs": [
		{
			"key": "martinDomain",
			"label": "Martin domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "postgresUser",
			"label": "Postgres user",
			"type": "username"
		},
		{
			"key": "postgresPassword",
			"label": "Postgres password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "martin",
			"dependsOn": [
				"postgresql"
			],
			"env": {
				"HOST": "https://${{ inputs.martinDomain }}",
				"DATABASE_URL": "postgresql://${{ inputs.postgresUser }}:${{ inputs.postgresPassword }}@${{ services.postgresql.host }}:5432/martin-db"
			},
			"volumes": [],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/maplibre/martin:v0.13.0",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"wget",
					"-q",
					"--spider",
					"http://127.0.0.1:3000"
				]
			},
			"public": {
				"port": 3000,
				"domain": "martinDomain"
			}
		},
		{
			"name": "postgresql",
			"dependsOn": [],
			"env": {
				"POSTGRES_USER": "${{ inputs.postgresUser }}",
				"POSTGRES_PASSWORD": "${{ inputs.postgresPassword }}",
				"POSTGRES_DB": "martin-db"
			},
			"volumes": [
				{
					"name": "martin-postgresql-data",
					"target": "/var/lib/postgresql/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "postgis/postgis:16-3.4-alpine",
			"ports": [],
			"healthcheck": {
				"type": "command",
				"command": [
					"sh",
					"-c",
					"pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"
				]
			}
		}
	]
}
