{
	"schema": 1,
	"id": "inkvoice",
	"name": "Inkvoice",
	"description": "Open-source invoicing for freelancers and small teams: invoices, online payments (Stripe & PayPal), expenses, multi-currency and reports.",
	"category": "finance",
	"tags": [
		"invoicing",
		"billing",
		"finance",
		"self-hosted"
	],
	"logo": "logos/inkvoice.svg",
	"website": "https://inkvoice.app/",
	"docs": "https://docs.inkvoice.app/",
	"version": "0.3.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/inkvoice",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "adminPass",
			"label": "Admin pass",
			"type": "password",
			"length": 16
		},
		{
			"key": "jwtSecret",
			"label": "JWT secret",
			"type": "password",
			"length": 48
		},
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		}
	],
	"services": [
		{
			"name": "inkvoice",
			"dependsOn": [],
			"env": {
				"ADMIN_USER": "admin",
				"ADMIN_PASS": "${{ inputs.adminPass }}",
				"JWT_SECRET": "${{ inputs.jwtSecret }}",
				"DATABASE_PATH": "/app/data/invoice.db",
				"PORT": "3000",
				"HOST": "0.0.0.0",
				"COOKIE_SECURE": "false"
			},
			"volumes": [
				{
					"name": "inkvoice-data",
					"target": "/app/data"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghcr.io/pigontech/inkvoice:0.3.0",
			"ports": [
				{
					"target": 3000,
					"protocol": "tcp"
				}
			],
			"public": {
				"port": 3000,
				"domain": "mainDomain"
			},
			"restart": "any",
			"resources": {
				"memoryMb": 512
			}
		}
	]
}
