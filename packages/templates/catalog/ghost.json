{
	"schema": 1,
	"id": "ghost",
	"name": "Ghost",
	"description": "Ghost is an open-source publishing platform for blogs, newsletters, and paid memberships.",
	"category": "cms",
	"tags": [
		"cms",
		"blog",
		"content",
		"management",
		"system"
	],
	"logo": "logos/ghost.jpg",
	"website": "https://ghost.org/",
	"docs": "https://ghost.org/docs/",
	"version": "6.0.0",
	"source": {
		"kind": "dokploy",
		"path": "blueprints/ghost",
		"license": "MIT"
	},
	"inputs": [
		{
			"key": "mainDomain",
			"label": "Main domain",
			"type": "domain",
			"role": "primary"
		},
		{
			"key": "dbPassword",
			"label": "DB password",
			"type": "password",
			"length": 32
		}
	],
	"services": [
		{
			"name": "ghost",
			"dependsOn": [],
			"env": {
				"database__client": "mysql",
				"database__connection__host": "${{ services.db.host }}",
				"database__connection__user": "root",
				"database__connection__password": "${{ inputs.dbPassword }}",
				"database__connection__database": "ghost",
				"url": "https://${{ inputs.mainDomain }}"
			},
			"volumes": [
				{
					"name": "ghost",
					"target": "/var/lib/ghost/content"
				}
			],
			"files": [],
			"kind": "application",
			"image": "ghost:6-alpine",
			"ports": [],
			"public": {
				"port": 2368,
				"domain": "mainDomain"
			},
			"restart": "any"
		},
		{
			"name": "db",
			"dependsOn": [],
			"env": {
				"MYSQL_ROOT_PASSWORD": "${{ inputs.dbPassword }}"
			},
			"volumes": [
				{
					"name": "db",
					"target": "/var/lib/mysql"
				}
			],
			"files": [],
			"kind": "database",
			"engine": "mysql",
			"version": "8.0"
		}
	]
}
