        "max_events": 25,
        "window": "2500ms",
      },
    },
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-e1:80",
      },
    ],
  },
]
`;

exports[`edge rules rate limit exemptions wrap the limiter in a client_ip guard 1`] = `
[
  {
    "handler": "subroute",
    "routes": [
      {
        "handle": [
          {
            "handler": "rate_limit",
            "rate_limits": {
              "ls-e1": {
                "key": "{http.vars.client_ip}",
                "max_events": 5,
                "window": "1000ms",
              },
            },
          },
        ],
        "match": [
          {
            "not": [
              {
                "client_ip": {
                  "ranges": [
                    "10.0.0.0/8",
                    "192.0.2.1",
                  ],
                },
              },
            ],
          },
        ],
      },
    ],
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-e1:80",
      },
    ],
  },
]
`;

exports[`edge rules block rules: snapshot, user agents are escaped into one case-insensitive pattern 1`] = `
[
  {
    "handler": "subroute",
    "routes": [
      {
        "handle": [
          {
            "body": "Forbidden",
            "handler": "static_response",
            "status_code": 403,
          },
        ],
        "match": [
          {
            "path": [
              "/.env",
              "/wp-admin*",
            ],
          },
          {
            "header_regexp": {
              "User-Agent": {
                "pattern": "(?i)(?:bad\\.bot\\(1\\)|sqlmap)",
              },
            },
          },
        ],
      },
    ],
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-e1:80",
      },
    ],
  },
]
`;

exports[`edge rules maintenance: snapshot, 503 page unless the client is allowed 1`] = `
[
  {
    "handler": "subroute",
    "routes": [
      {
        "handle": [
          {
            "body": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Under maintenance · Acme &lt;Ops&gt;</title><style>:root\\{color-scheme:light dark;--fg:#171717;--muted:#666;--bg:#fafafa;--line:#e5e5e5\\}@media(prefers-color-scheme:dark)\\{:root\\{--fg:#ededed;--muted:#a1a1a1;--bg:#0a0a0a;--line:#262626\\}\\}body\\{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--fg);font:15px/1.6 system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased\\}main\\{max-width:28rem;padding:2rem 1.5rem\\}img\\{border-radius:8px;display:block;margin-bottom:1.5rem\\}h1\\{font-size:1.25rem;font-weight:600;margin:0 0 .5rem;text-wrap:balance\\}p\\{margin:0;color:var(--muted)\\}footer\\{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--line);font-size:13px;color:var(--muted)\\}</style></head><body><main><h1>We&#39;ll be right back</h1><p>Back at 14:00</p><footer>Acme &lt;Ops&gt;</footer></main></body></html>",
            "handler": "static_response",
            "headers": {
              "Cache-Control": [
                "no-store",
              ],
              "Content-Type": [
                "text/html; charset=utf-8",
              ],
              "Retry-After": [
                "300",
              ],
            },
            "status_code": 503,
          },
        ],
        "match": [
          {
            "not": [
              {
                "client_ip": {
                  "ranges": [
                    "203.0.113.0/24",
                  ],
                },
              },
            ],
          },
        ],
      },
    ],
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-e1:80",
      },
    ],
  },
]
`;

exports[`edge rules error pages: snapshot, one error route per distinct page, only for 502-504 1`] = `
{
  "routes": [
    {
      "handle": [
        {
          "body": "<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Temporarily unavailable · Acme &lt;Ops&gt;</title><style>:root\\{color-scheme:light dark;--fg:#171717;--muted:#666;--bg:#fafafa;--line:#e5e5e5\\}@media(prefers-color-scheme:dark)\\{:root\\{--fg:#ededed;--muted:#a1a1a1;--bg:#0a0a0a;--line:#262626\\}\\}body\\{margin:0;min-height:100vh;display:grid;place-items:center;background:var(--bg);color:var(--fg);font:15px/1.6 system-ui,-apple-system,sans-serif;-webkit-font-smoothing:antialiased\\}main\\{max-width:28rem;padding:2rem 1.5rem\\}img\\{border-radius:8px;display:block;margin-bottom:1.5rem\\}h1\\{font-size:1.25rem;font-weight:600;margin:0 0 .5rem;text-wrap:balance\\}p\\{margin:0;color:var(--muted)\\}footer\\{margin-top:2rem;padding-top:1rem;border-top:1px solid var(--line);font-size:13px;color:var(--muted)\\}</style></head><body><main><h1>This site is temporarily unavailable</h1><p>The application did not respond, often because a new version is starting. Try again in a moment.</p><footer>Acme &lt;Ops&gt;</footer></main></body></html>",
          "handler": "static_response",
          "headers": {
            "Cache-Control": [
              "no-store",
            ],
            "Content-Type": [
              "text/html; charset=utf-8",
            ],
          },
          "status_code": "{http.error.status_code}",
        },
      ],
      "match": [
        {
          "expression": "{http.error.status_code} in [502, 503, 504]",
          "host": [
            "edge.example.com",
          ],
        },
        {
          "expression": "{http.error.status_code} in [502, 503, 504]",
          "host": [
            "two.example.com",
          ],
          "path": [
            "/api",
            "/api/*",
          ],
        },
      ],
      "terminal": true,
    },
    {
      "handle": [
        {
          "body": "<p>custom</p>",
          "handler": "static_response",
          "headers": {
            "Cache-Control": [
              "no-store",
            ],
            "Content-Type": [
              "text/html; charset=utf-8",
            ],
          },
          "status_code": "{http.error.status_code}",
        },
      ],
      "match": [
        {
          "expression": "{http.error.status_code} in [502, 503, 504]",
          "host": [
            "three.example.com",
          ],
        },
      ],
      "terminal": true,
    },
  ],
}
`;

exports[`web analytics script and beacon answered before the upstream, under the path prefix, after access checks 1`] = `
{
  "handler": "subroute",
  "routes": [
    {
      "handle": [
        {
          "body": "(function(){var d=document,l=location,w=window,s=d.currentScript,b=s&&s.src?new URL(s.src).pathname.replace(/a\\.js$/,""):"/_ls/",last,first=1;function send(n){if(w.navigator.webdriver||/^(localhost|127\\.|\\[::1\\])/.test(l.hostname))return;var m=/[?&]utm_source=([^&#]*)/.exec(l.search),u=l.pathname+(m?"?utm_source="+m[1]:"");if(n=="pageview"){if(u==last)return;last=u}var q="n="+encodeURIComponent(n)+"&u="+encodeURIComponent(u)+"&w="+w.innerWidth;if(n=="pageview"&&first){first=0;q+="&r="+encodeURIComponent(d.referrer)}try{fetch(b+"e?"+q,{keepalive:true,credentials:"omit"})}catch(e){}}var h=w.history,p=h.pushState;if(p){h.pushState=function(){p.apply(this,arguments);send("pageview")};w.addEventListener("popstate",function(){send("pageview")})}w.lsa=function(n){send(String(n).slice(0,64))};send("pageview")})();",
          "handler": "static_response",
          "headers": {
            "Cache-Control": [
              "public, max-age=3600",
            ],
            "Content-Type": [
              "application/javascript; charset=utf-8",
            ],
          },
          "status_code": 200,
        },
      ],
      "match": [
        {
          "path": [
            "/blog/_ls/a.js",
          ],
        },
      ],
    },
    {
      "handle": [
        {
          "handler": "static_response",
          "headers": {
            "Cache-Control": [
              "no-store",
            ],
          },
          "status_code": 204,
        },
      ],
      "match": [
        {
          "path": [
            "/blog/_ls/e",
          ],
        },
      ],
    },
  ],
}
`;
