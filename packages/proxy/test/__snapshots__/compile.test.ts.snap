exports[`full config snapshot 1`] = `
{
  "admin": {
    "listen": "0.0.0.0:2019",
  },
  "apps": {
    "http": {
      "grace_period": "10s",
      "http_port": 80,
      "https_port": 443,
      "servers": {
        "http": {
          "listen": [
            ":80",
          ],
          "logs": {
            "default_logger_name": "ls-access",
          },
          "routes": [
            {
              "@id": "ls-https-redirect",
              "handle": [
                {
                  "handler": "static_response",
                  "headers": {
                    "Location": [
                      "https://{http.request.host}{http.request.uri}",
                    ],
                  },
                  "status_code": 308,
                },
              ],
              "match": [
                {
                  "host": [
                    "*.preview.example.com",
                    "api.example.net",
                    "app.example.com",
                    "ls.example.com",
                    "shop.example.org",
                    "www.example.com",
                  ],
                },
              ],
              "terminal": true,
            },
            {
              "@id": "ls-domain-d6",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "try_duration": "30s",
                    "try_interval": "250ms",
                  },
                  "upstreams": [
                    {
                      "dial": "ls-svc-e5:80",
                    },
                  ],
                },
              ],
              "match": [
                {
