exports[`access rules forward_auth 1`] = `
[
  {
    "handle_response": [
      {
        "match": {
          "status_code": [
            2,
          ],
        },
        "routes": [
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "delete": [
                    "Remote-Groups",
                    "Remote-User",
                  ],
                },
              },
            ],
          },
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "set": {
                    "Remote-Groups": [
                      "{http.reverse_proxy.header.Remote-Groups}",
                    ],
                  },
                },
              },
            ],
            "match": [
              {
                "not": [
                  {
                    "vars": {
                      "{http.reverse_proxy.header.Remote-Groups}": [
                        "",
                      ],
                    },
                  },
                ],
              },
            ],
          },
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "set": {
                    "Remote-User": [
                      "{http.reverse_proxy.header.Remote-User}",
                    ],
                  },
                },
              },
            ],
            "match": [
              {
                "not": [
                  {
                    "vars": {
                      "{http.reverse_proxy.header.Remote-User}": [
                        "",
                      ],
                    },
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    "handler": "reverse_proxy",
    "headers": {
      "request": {
        "set": {
