exports[`access rules ip_allow 1`] = `
[
  {
    "handler": "subroute",
    "routes": [
      {
        "handle": [
          {
            "body": "Forbidden",
            "handler": "static_response",
            "status_code": 403,
          },
        ],
        "match": [
          {
            "not": [
              {
                "remote_ip": {
                  "ranges": [
                    "203.0.113.0/24",
                    "2001:db8::/32",
                  ],
                },
              },
            ],
          },
        ],
      },
    ],
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-a1:8080",
      },
    ],
  },
]
`;

