            },
            {
              "@id": "ls-domain-wild",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "upstreams": [
                    {
                      "dial": "ls-svc-tenants:80",
                    },
                  ],
                },
              ],
              "match": [
                {
                  "host": [
                    "*.shop.example.com",
                  ],
                },
              ],
              "terminal": true,
            },
            {
              "@id": "ls-not-found-https",
              "handle": [
                {
                  "body": "<!doctype html><html><head><meta charset="utf-8"><title>Not found</title></head><body style="font-family:system-ui,sans-serif;display:grid;place-items:center;min-height:90vh;color:#555"><div><h1>404</h1><p>No application is configured for this address.</p></div></body></html>",
                  "handler": "static_response",
                  "headers": {
                    "Content-Type": [
                      "text/html; charset=utf-8",
                    ],
                  },
                  "status_code": 404,
                },
              ],
              "terminal": true,
            },
          ],
        },
      },
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "challenges": {
                  "dns": {
                    "provider": {
                      "api_token": "cf-token",
                      "name": "cloudflare",
                    },
                  },
                },
                "email": "ops@example.com",
                "module": "acme",
              },
            ],
            "subjects": [
              "*.shop.example.com",
              "shop.example.com",
            ],
          },
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "email": "ops@example.com",
                "module": "acme",
              },
            ],
          },
        ],
      },
    },
  },
  "logging": {
    "logs": {
      "access": {
        "encoder": {
          "format": "json",
        },
        "include": [
          "http.log.access.ls-access",
        ],
        "writer": {
          "output": "stdout",
        },
      },
      "default": {
        "encoder": {
          "format": "json",
        },
        "exclude": [
          "http.log.access.ls-access",
        ],
        "writer": {
          "output": "stderr",
        },
      },
    },
  },
  "storage": {
    "address": [
      "ls-redis:6379",
    ],
    "db": 2,
    "key_prefix": "logistack/caddy",
    "module": "redis",
    "password": "s3cret",
    "tls_enabled": false,
  },
}
`;
