exports[`access rules forward_auth 1`] = `
[
  {
    "handle_response": [
      {
        "match": {
          "status_code": [
            2,
          ],
        },
        "routes": [
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "delete": [
                    "Remote-Groups",
                    "Remote-User",
                  ],
                },
              },
            ],
          },
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "set": {
                    "Remote-Groups": [
                      "{http.reverse_proxy.header.Remote-Groups}",
                    ],
                  },
                },
              },
            ],
            "match": [
              {
                "not": [
                  {
                    "vars": {
                      "{http.reverse_proxy.header.Remote-Groups}": [
                        "",
                      ],
                    },
                  },
                ],
              },
            ],
          },
          {
            "handle": [
              {
                "handler": "headers",
                "request": {
                  "set": {
                    "Remote-User": [
                      "{http.reverse_proxy.header.Remote-User}",
                    ],
                  },
                },
              },
            ],
            "match": [
              {
                "not": [
                  {
                    "vars": {
                      "{http.reverse_proxy.header.Remote-User}": [
                        "",
                      ],
                    },
                  },
                ],
              },
            ],
          },
        ],
      },
    ],
    "handler": "reverse_proxy",
    "headers": {
      "request": {
        "set": {
          "Host": [
            "{http.reverse_proxy.upstream.hostport}",
          ],
          "X-Forwarded-Method": [
            "{http.request.method}",
          ],
          "X-Forwarded-Uri": [
            "{http.request.uri}",
          ],
        },
      },
    },
    "rewrite": {
      "method": "GET",
      "uri": "/api/verify?rd=https%3A%2F%2Flogin",
    },
    "transport": {
      "protocol": "http",
      "tls": {},
    },
    "upstreams": [
      {
        "dial": "auth.example.com:443",
      },
    ],
  },
  {
    "handler": "reverse_proxy",
    "load_balancing": {
      "try_duration": "30s",
      "try_interval": "250ms",
    },
    "upstreams": [
      {
        "dial": "ls-svc-a1:8080",
      },
    ],
  },
]
`;

exports[`access rules forward_auth over http, no headers 1`] = `
[
  {
    "handle_response": [
