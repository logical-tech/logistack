exports[`snapshots database redis 1`] = `
{
  "EndpointSpec": {
    "Mode": "vip",
    "Ports": [],
  },
  "Labels": {
    "logistack.deployment": "dep_one0000000000000000000000",
    "logistack.environment": "env_prod00000000000000000000",
    "logistack.kind": "db",
    "logistack.managed": "true",
    "logistack.org": "org_acme",
    "logistack.resource": "svc_db00000000000000000000000",
  },
  "Mode": {
    "Replicated": {
      "Replicas": 1,
    },
  },
  "Name": "ls-svc-db00000000000000000000000",
  "RollbackConfig": {
    "FailureAction": "pause",
    "Monitor": 30000000000,
    "Order": "stop-first",
    "Parallelism": 1,
  },
  "TaskTemplate": {
    "ContainerSpec": {
      "Command": [
        "sh",
        "-c",
        "umask 077 && printf 'requirepass %s\\n' "$REDIS_PASSWORD" > /tmp/redis.conf && chown redis:redis /tmp/redis.conf && exec docker-entrypoint.sh redis-server /tmp/redis.conf --appendonly yes",
      ],
      "Configs": [],
      "Env": [
        "REDIS_PASSWORD=pw",
      ],
      "Healthcheck": {
        "Interval": 5000000000,
        "Retries": 3,
        "StartInterval": 1000000000,
        "StartPeriod": 30000000000,
        "Test": [
          "CMD-SHELL",
          "REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli ping | grep -q PONG",
        ],
        "Timeout": 3000000000,
      },
      "Image": "redis:1",
      "Labels": {
        "logistack.deployment": "dep_one0000000000000000000000",
        "logistack.kind": "db",
        "logistack.managed": "true",
        "logistack.org": "org_acme",
        "logistack.resource": "svc_db00000000000000000000000",
      },
      "Mounts": [
        {
          "Source": "ls-vol-db00000000000000000000000",
          "Target": "/data",
          "Type": "volume",
          "VolumeOptions": {
            "Labels": {
              "logistack.kind": "volume",
              "logistack.managed": "true",
              "logistack.org": "org_acme",
              "logistack.resource": "svc_db00000000000000000000000",
            },
          },
        },
      ],
      "Secrets": [],
      "StopGracePeriod": 10000000000,
    },
    "Networks": [
