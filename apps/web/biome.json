{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"root": false,
	"extends": "//",
	"files": {
		"includes": ["**", "!src/routeTree.gen.ts", "!docs/screenshots"]
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"overrides": [
		{
			"includes": ["src/components/ui/**"],
			"linter": {
				"rules": {
					"a11y": {
						"useSemanticElements": "off",
						"useFocusableInteractive": "off",
						"useKeyWithClickEvents": "off"
					},
					"suspicious": { "noDocumentCookie": "off" },
					"correctness": { "useExhaustiveDependencies": "off" }
				}
			}
		},
		{
			"includes": ["src/styles/motion.css"],
			"linter": {
				"rules": { "complexity": { "noImportantStyles": "off" } }
			}
		}
	]
}
