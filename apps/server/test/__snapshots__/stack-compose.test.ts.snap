// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`stackCompose writes desired state and masks secrets 1`] = `
"services:
  web:
    image: ghcr.io/acme/web:1.2
    ports:
      - 3000/tcp
    environment:
      NODE_ENV: production
      API_KEY: "<secret>"
    volumes:
      - uploads:/app/uploads
    x-domains:
      - web.example.com
  db:
    image: postgres:17
    environment:
      POSTGRES_PASSWORD: "<secret>"
volumes:
  uploads:
    {}"
`;
